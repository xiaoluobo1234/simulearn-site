---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="工程仿真书库" description="按原书章节和顺序阅读管理员审核发布的工程与仿真类电子书。" lang="zh">
  <section class="books-hero">
    <div class="container">
      <span>SIMULEARN / ENGINEERING BOOKS</span>
      <h1>工程仿真书库</h1>
      <p>管理员在外部完成解析并审核后发布；正文保持原始章节、公式编号和内容顺序，网站不运行 MinerU，也不改写原书。</p>
    </div>
  </section>

  <section class="container books-section">
    <div class="books-toolbar">
      <label>
        <span>搜索书名、作者或章节</span>
        <input type="search" placeholder="例如：有限元、传热、封装可靠性" data-book-search />
      </label>
      <details class="book-request">
        <summary>需要什么书籍？告诉我们 →</summary>
        <form data-request-form>
          <p>提交后管理员会收到需求提醒，尽量补充到书库。</p>
          <div class="request-fields">
            <input type="text" name="title" placeholder="书名（必填）" required maxlength="200" />
            <input type="text" name="author" placeholder="作者（可选）" maxlength="200" />
          </div>
          <textarea name="notes" placeholder="为什么需要这本书？或补充信息（可选）" rows="2" maxlength="2000"></textarea>
          <button type="submit">提交需求</button>
          <p class="request-feedback" data-request-feedback hidden></p>
        </form>
      </details>
    </div>
    <div class="book-grid" data-book-grid>
      <p class="state">正在读取书库……</p>
    </div>
  </section>
</BaseLayout>

<script>
  type Book = {
    id: string;
    slug: string;
    title: string;
    author: string;
    publisher: string;
    year: string;
    description: string;
    pageCount?: number;
    coverUrl?: string;
    chapterCount: number;
    toc: Array<{ title: string }>;
    updatedAt: string;
  };

  const grid = document.querySelector<HTMLElement>('[data-book-grid]');
  const search = document.querySelector<HTMLInputElement>('[data-book-search]');
  let books: Book[] = [];

  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  })[character] || character);

  function render(query = '') {
    if (!grid) return;
    const keyword = query.trim().toLowerCase();
    const fuzzy = (text: string, value: string) => {
      if (!value || text.includes(value)) return true;
      let cursor = 0;
      for (const character of text) {
        if (character === value[cursor]) cursor += 1;
        if (cursor === value.length) return true;
      }
      return false;
    };
    const filtered = books.filter((book) => {
      const haystack = [book.title, book.author, book.publisher, ...book.toc.map((item) => item.title)].join(' ').toLowerCase();
      return fuzzy(haystack, keyword);
    });
    if (!filtered.length) {
      grid.innerHTML = `<p class="state">${books.length ? '没有匹配的书籍。' : '书库中还没有已发布书籍。'}</p>`;
      return;
    }
    grid.innerHTML = filtered.map((book) => `
      <article class="book-card">
        <a class="cover" href="/books/${encodeURIComponent(book.slug)}/">
          ${book.coverUrl
            ? `<img src="${escapeHtml(book.coverUrl)}" alt="${escapeHtml(book.title)}封面" loading="lazy" />`
            : `<span>SL<br />BOOK</span>`}
        </a>
        <div>
          <small>${escapeHtml(book.year || '年份未录入')} · ${book.pageCount || '—'} 页 · ${book.chapterCount} 章</small>
          <h2><a href="/books/${encodeURIComponent(book.slug)}/">${escapeHtml(book.title)}</a></h2>
          <p class="byline">${escapeHtml(book.author || '作者未录入')}${book.publisher ? ` · ${escapeHtml(book.publisher)}` : ''}</p>
          <p>${escapeHtml(book.description || '暂无简介。')}</p>
          <a class="read" href="/books/${encodeURIComponent(book.slug)}/">开始阅读 →</a>
        </div>
      </article>
    `).join('');
  }

  fetch('/api/books')
    .then(async (response) => {
      const body = await response.json();
      if (!response.ok || !body.ok) throw new Error(body.error || '读取失败');
      books = body.books || [];
      render();
    })
    .catch((error) => {
      if (grid) grid.innerHTML = `<p class="state error">${escapeHtml(error.message)} 请检查 R2 BOOKS 绑定。</p>`;
    });

  search?.addEventListener('input', () => render(search.value));

  const requestForm = document.querySelector<HTMLFormElement>('[data-request-form]');
  requestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const feedback = form.querySelector<HTMLElement>('[data-request-feedback]');
    const title = (form.elements.namedItem('title') as HTMLInputElement).value.trim();
    if (!title) return;
    const author = (form.elements.namedItem('author') as HTMLInputElement).value.trim();
    const notes = (form.elements.namedItem('notes') as HTMLTextAreaElement).value.trim();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) { button.disabled = true; button.textContent = '提交中…'; }
    try {
      const response = await fetch('/api/books/requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, author, notes }),
      });
      const body = await response.json();
      if (!response.ok || !body.ok) throw new Error(body.error || '提交失败');
      if (feedback) {
        feedback.hidden = false;
        feedback.textContent = '已收到你的需求，管理员会尽快处理。';
        feedback.className = 'request-feedback success';
      }
      form.reset();
    } catch (error) {
      if (feedback) {
        feedback.hidden = false;
        feedback.textContent = error instanceof Error ? error.message : '提交失败，请稍后再试。';
        feedback.className = 'request-feedback error';
      }
    } finally {
      if (button) { button.disabled = false; button.textContent = '提交需求'; }
    }
  });
</script>

<style>
  .books-hero { padding: 5rem 0 4rem; color: white; background: var(--color-primary); }
  .books-hero span { font: 600 .72rem/1 var(--font-mono); letter-spacing: .16em; color: var(--color-accent-light); }
  .books-hero h1 { margin: 1rem 0 .7rem; font-size: clamp(2.5rem, 6vw, 4.8rem); }
  .books-hero p { max-width: 760px; color: #c6d5db; }
  .books-section { padding-block: 3rem 5rem; }
  .books-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .books-toolbar label { display: grid; gap: .5rem; width: min(620px, 100%); font-size: .8rem; color: var(--color-text-secondary); }
  .books-toolbar input { width: 100%; padding: .85rem 1rem; border: 1px solid var(--color-border); background: white; font: inherit; }
  .book-request { min-width: 280px; }
  .book-request > summary { display: inline-block; white-space: nowrap; font-weight: 650; cursor: pointer; color: var(--color-primary); list-style: none; }
  .book-request > summary::-webkit-details-marker { display: none; }
  .book-request[open] > summary { margin-bottom: .8rem; }
  .book-request form { display: grid; gap: .6rem; padding: 1rem; border: 1px solid var(--color-border); background: white; }
  .book-request form > p { margin: 0; color: var(--color-text-secondary); font-size: .75rem; }
  .request-fields { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .book-request input[type="text"], .book-request textarea { width: 100%; padding: .6rem .7rem; border: 1px solid var(--color-border); background: white; font: inherit; font-size: .82rem; }
  .book-request textarea { resize: vertical; }
  .book-request button[type="submit"] { padding: .6rem 1rem; color: white; background: var(--color-accent); border: 0; cursor: pointer; font-weight: 650; font-size: .82rem; }
  .book-request button[type="submit"]:disabled { opacity: .6; cursor: wait; }
  .request-feedback { margin: 0; padding: .5rem .7rem; font-size: .75rem; border-radius: 3px; }
  .request-feedback.success { color: #2d6a4f; background: #d4f1e0; }
  .request-feedback.error { color: #9b3e20; background: #fff1ee; }
  .book-grid { display: grid; gap: 1rem; }
  .book-card { display: grid; grid-template-columns: 170px 1fr; gap: 1.7rem; padding: 1.5rem; border: 1px solid var(--color-border); background: white; }
  .cover { min-height: 220px; display: grid; place-items: center; overflow: hidden; color: white; background: linear-gradient(145deg, #071723, #0a777a); font: 700 1.1rem/1.5 var(--font-mono); letter-spacing: .12em; text-align: center; }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .book-card small { font: 500 .7rem/1 var(--font-mono); color: var(--color-accent); }
  .book-card h2 { margin: .55rem 0 .4rem; font-size: 1.55rem; }
  .book-card p { margin: .55rem 0; max-width: 760px; color: var(--color-text-secondary); }
  .book-card .byline { color: var(--color-primary); font-weight: 650; }
  .read { display: inline-block; margin-top: .7rem; font-weight: 700; }
  .state { grid-column: 1 / -1; padding: 2rem; border: 1px dashed var(--color-border); text-align: center; }
  .error { color: #9b3e20; }
  @media (max-width: 700px) {
    .books-toolbar { align-items: stretch; flex-direction: column; }
    .book-card { grid-template-columns: 95px 1fr; gap: 1rem; padding: 1rem; }
    .cover { min-height: 135px; }
    .book-request { min-width: 0; }
    .request-fields { grid-template-columns: 1fr; }
  }
</style>
