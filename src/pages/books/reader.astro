---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="书籍阅读器" description="SimuLearn 工程仿真电子书阅读器" lang="zh" flush>
  <div class="reader-state" data-reader-state>正在加载书籍……</div>
  <article class="book-reader" data-book-reader hidden>
    <header class="book-head">
      <div class="container">
        <a href="/books">← 返回书库</a>
        <span data-book-kicker>SIMULEARN BOOK</span>
        <h1 data-book-title></h1>
        <p data-book-description></p>
        <dl data-book-meta></dl>
      </div>
    </header>
    <div class="reader-layout container-wide">
      <aside class="toc">
        <button type="button" data-toc-toggle>目录</button>
        <nav data-toc></nav>
      </aside>
      <main class="book-content">
        <section class="guide" data-guide-section hidden>
          <span>EDITOR / GUIDE</span>
          <h2>本书导读</h2>
          <div data-book-guide></div>
          <p class="notice">导读与正文由管理员审核发布。正文来自管理员上传的 MinerU 解析结果，网站不再运行解析模型，也不改写原文。</p>
        </section>
        <div data-chapters></div>
      </main>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  window.MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      packages: { '[+]': ['boldsymbol'] },
    },
    loader: { load: ['[tex]/boldsymbol'] },
  };
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
<script>
  import MarkdownIt from 'markdown-it';

  type Heading = { id: string; title: string; level: number };
  type Chapter = { id: string; title: string; level: number; markdown?: string; html?: string; headings?: Heading[] };
  type Book = {
    meta: {
      title: string; author: string; publisher: string; year: string; description: string;
      pageCount?: number; guide?: string; updatedAt?: string;
    };
    toc: Array<{ id: string; title: string; level: number }>;
    chapters: Chapter[];
  };
  const state = document.querySelector<HTMLElement>('[data-reader-state]');
  const reader = document.querySelector<HTMLElement>('[data-book-reader]');
  const slug = decodeURIComponent(location.pathname.split('/').filter(Boolean)[1] || '');
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  })[character] || character);
  const markdown = new MarkdownIt({ html: false, linkify: true, typographer: false });

  function renderChapter(chapter: Chapter) {
    if (!chapter.markdown) return chapter.html || '';
    let headingIndex = 0;
    const mathStore: string[] = [];
    const protectMath = (text: string) => text
      .replace(/\$\$([\s\S]+?)\$\$/g, (m) => { mathStore.push(m); return `QMATH${mathStore.length - 1}END`; })
      .replace(/\$([^\n$]+?)\$/g, (m) => { mathStore.push(m); return `QMATH${mathStore.length - 1}END`; });
    const restoreMath = (html: string) => html
      .replace(/<p>\s*(QMATH\d+END)\s*<\/p>/g, '$1')
      .replace(/QMATH(\d+)END/g, (_, i) => mathStore[Number(i)]);
    return restoreMath(markdown.render(protectMath(chapter.markdown))).replace(/<h([1-6])>/g, (opening, level) => {
      const heading = chapter.headings?.[headingIndex++];
      if (headingIndex === 1 && heading?.id === chapter.id) return opening;
      return heading ? `<h${level} id="${escapeHtml(heading.id)}">` : opening;
    });
  }

  function typeset(attempt = 0) {
    const mathJax = (window as unknown as { MathJax?: { typesetPromise?: () => Promise<void> } }).MathJax;
    if (mathJax?.typesetPromise) {
      mathJax.typesetPromise();
    } else if (attempt < 20) {
      window.setTimeout(() => typeset(attempt + 1), 250);
    }
  }

  async function load() {
    try {
      const response = await fetch(`/api/books/${encodeURIComponent(slug)}`);
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || '书籍不存在');
      const book = payload as Book;
      document.title = `${book.meta.title} | SimuLearn`;
      document.querySelector<HTMLElement>('[data-book-title]')!.textContent = book.meta.title;
      document.querySelector<HTMLElement>('[data-book-description]')!.textContent = book.meta.description || '';
      const meta = document.querySelector<HTMLElement>('[data-book-meta]')!;
      meta.innerHTML = [
        ['作者', book.meta.author || '未录入'],
        ['出版社', book.meta.publisher || '未录入'],
        ['出版年份', book.meta.year || '未录入'],
        ['页数', book.meta.pageCount || '—'],
      ].map(([label, value]) => `<div><dt>${label}</dt><dd>${escapeHtml(value)}</dd></div>`).join('');

      const toc = document.querySelector<HTMLElement>('[data-toc]')!;
      type TocNode = { id: string; title: string; level: number; children: TocNode[] };
      const roots: TocNode[] = [];
      const stack: TocNode[] = [];
      book.toc.forEach((item) => {
        const node: TocNode = { ...item, children: [] };
        while (stack.length && stack[stack.length - 1].level >= node.level) stack.pop();
        (stack.length ? stack[stack.length - 1].children : roots).push(node);
        stack.push(node);
      });
      const renderToc = (nodes: TocNode[]): string => `<ul>${nodes.map((node) => node.children.length
        ? `<li><details open><summary>${escapeHtml(node.title)}</summary><a href="#${encodeURIComponent(node.id)}">跳到本节</a>${renderToc(node.children)}</details></li>`
        : `<li><a href="#${encodeURIComponent(node.id)}">${escapeHtml(node.title)}</a></li>`
      ).join('')}</ul>`;
      toc.innerHTML = renderToc(roots);
      const chapters = document.querySelector<HTMLElement>('[data-chapters]')!;
      chapters.innerHTML = book.chapters.map((chapter) => `
        <section class="chapter" id="${escapeHtml(chapter.id)}">
          <div class="mineru-body">${renderChapter(chapter)}</div>
        </section>
      `).join('');
      if (book.meta.guide) {
        const guide = document.querySelector<HTMLElement>('[data-guide-section]')!;
        guide.hidden = false;
        document.querySelector<HTMLElement>('[data-book-guide]')!.textContent = book.meta.guide;
      }
      state?.remove();
      if (reader) reader.hidden = false;
      toc.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        document.querySelector('.toc')?.classList.remove('open');
      }));
      typeset();
    } catch (error) {
      if (state) state.textContent = error instanceof Error ? error.message : '加载失败';
    }
  }
  document.querySelector('[data-toc-toggle]')?.addEventListener('click', () => document.querySelector('.toc')?.classList.toggle('open'));
  load();
</script>

<style is:global>
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
  .reader-state { min-height: 60vh; display: grid; place-items: center; color: var(--color-text-secondary); }
  .book-head { padding: 4rem 0 3rem; color: white; background: #071723; }
  .book-head a { color: #8dd8d5; }
  .book-head span { display: block; margin-top: 2rem; font: 600 .7rem/1 var(--font-mono); letter-spacing: .15em; color: #39c8c1; }
  .book-head h1 { max-width: 1000px; margin: .8rem 0; font-size: clamp(2.2rem, 5vw, 4.2rem); }
  .book-head p { max-width: 820px; color: #c5d2d8; }
  .book-head dl { display: flex; flex-wrap: wrap; gap: .7rem 2rem; margin-top: 1.5rem; }
  .book-head dl div { display: flex; gap: .4rem; }
  .book-head dt { color: #7fa0ae; }
  .book-head dd { margin: 0; }
  .reader-layout { display: grid; grid-template-columns: minmax(210px, 280px) minmax(0, 900px); justify-content: center; gap: 3.5rem; padding-block: 3rem 6rem; }
  .toc { position: relative; }
  .toc > button { display: none; }
  .toc nav { position: sticky; top: 95px; max-height: calc(100vh - 120px); overflow: auto; padding-right: 1rem; border-right: 1px solid var(--color-border); }
  .toc ul { margin: 0; padding-left: 1rem; list-style: none; }
  .toc > nav > ul { padding-left: 0; }
  .toc summary { padding: .42rem .5rem; cursor: pointer; color: var(--color-primary); font-size: .82rem; font-weight: 650; }
  .toc a { display: block; padding: .42rem .5rem; color: var(--color-text-secondary); font-size: .82rem; line-height: 1.35; }
  .toc a:hover { color: var(--color-accent); background: var(--color-code-bg); }
  .guide { margin-bottom: 3.5rem; padding: 1.6rem; border: 1px solid #d9c3a4; background: #fff7ea; white-space: pre-wrap; }
  .guide > span { font: 600 .68rem/1 var(--font-mono); letter-spacing: .14em; color: #9a5a20; }
  .guide h2 { margin: .6rem 0 1rem; }
  .guide .notice { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e6d5bb; color: #765a3d; font-size: .8rem; }
  .chapter { padding-bottom: 2.5rem; }
  .chapter-summary { margin: 0 0 1.5rem; padding: 1rem 1.2rem; border-left: 3px solid var(--color-accent); background: var(--color-code-bg); }
  .chapter-summary strong { font-size: .78rem; color: var(--color-accent); }
  .chapter-summary p { margin: .4rem 0 0; color: var(--color-text-secondary); }
  .mineru-body { font-size: 1rem; line-height: 1.85; color: #152b37; }
  .mineru-body h1, .mineru-body h2, .mineru-body h3, .mineru-body h4 { margin: 2em 0 .7em; scroll-margin-top: 90px; color: #071f2d; }
  .book-anchor { display: block; position: relative; top: -90px; visibility: hidden; }
  .mineru-body img { display: block; max-width: 100%; height: auto; margin: 1.6rem auto; }
  .mineru-body table { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; }
  .mineru-body th, .mineru-body td { padding: .55rem .7rem; border: 1px solid var(--color-border); }
  .mineru-body pre { overflow-x: auto; padding: 1rem; background: #071723; color: #d9f4f1; }
  .mineru-body blockquote { margin-left: 0; padding-left: 1rem; border-left: 3px solid var(--color-border); color: var(--color-text-secondary); }
  @media (max-width: 900px) {
    .reader-layout { grid-template-columns: 1fr; gap: 1rem; padding-top: 1rem; }
    .toc { position: sticky; top: 70px; z-index: 20; background: white; }
    .toc > button { width: 100%; display: block; padding: .8rem; border: 1px solid var(--color-border); background: white; }
    .toc nav { display: none; position: absolute; inset: 100% 0 auto; max-height: 60vh; padding: .7rem; border: 1px solid var(--color-border); background: white; box-shadow: var(--shadow-lg); }
    .toc.open nav { display: block; }
  }
</style>
