---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { diagnosticRecords } from '../../data/diagnostics';
import '../../styles/diagnostics.css';
const fields = [
  ['model','模型、载荷与单位','写明几何、单元、材料、载荷和支承条件'],
  ['symptom','实际观察到的异常','保留原始现象、报错或首条异常，不先下根因结论'],
  ['expected','预期结果与依据','参考手算、基准或对照，说明适用条件'],
  ['hypothesis','可能原因与尚缺证据','区分猜测、已排除原因与仍不确定的部分'],
  ['attempts','我实际做过的检查','按顺序写检查内容、结果和依据；未执行的不要写成已完成'],
  ['actual','实际输出或日志摘录','未运行时写未运行；给输出附上环境与工况'],
  ['change','实际修改与版本','一次改了什么，修改前后文件或提交如何对应'],
  ['retest','复测结果与比较','写明目标量、输入是否一致、前后差异与仍未解释的问题'],
  ['evidence','证据、文件与来源链接','保存文件位置、截图或日志说明；本页不上传附件'],
  ['next','下一项任务与完成条件','只定一项可观察的验证任务'],
];
const diagnosticData=JSON.stringify(diagnosticRecords.map(card=>({id:card.slug,title:card.title,href:`/diagnostic/${card.slug}/`}))).replace(/</g,'\\u003c');
---
<BaseLayout title="私人失败复盘" description="记录真实的仿真异常、假设、检查、修改与复测；默认保存为私人草稿。" flush>
  <section class="diagnostic-hero diagnostic-hero--compact"><div class="container-wide"><div class="diagnostic-breadcrumb"><a href="/failures/">失败博物馆</a><span>/</span>私人复盘</div><span class="diagnostic-eyebrow">YOUR EVIDENCE, YOUR REVIEW</span><h1>把一次失败，记录完整。</h1><p>实际做过的检查与计划分别写；未运行、未确定的部分可以保留为空。</p></div></section>
  <div class="container-wide failure-workspace" data-failure-workbench><div class="failure-auth" id="failure-auth" role="status">正在读取账户…</div><div class="failure-workspace-grid"><aside class="failure-records-panel"><div class="diagnostic-section-heading"><h2>我的复盘</h2><button type="button" id="failure-new" class="diagnostic-button diagnostic-button--quiet">新建</button></div><div id="failure-list"><p>登录后读取私人记录。</p></div><a href="/learning/records/" id="failure-records">到学习工作台管理记录 →</a><p class="diagnostic-footnote">记录使用现有账户保存。私人正文不进入全站搜索，也不加入最近浏览。</p></aside>
    <section class="failure-editor"><form id="failure-form"><input type="hidden" name="diagnosticId" /><label class="failure-title">复盘标题<input type="text" name="title" maxlength="200" placeholder="描述一个具体的问题" /></label><div class="failure-fields-grid"><label>实际发生日期<input name="date" maxlength="200" placeholder="未提供；不自动填今天" /></label><label>软件或工具<input name="software" maxlength="200" placeholder="例如：MAPDL / Python" /></label><label>版本与运行环境<input name="version" maxlength="200" placeholder="版本号、系统或代码版本" /></label><label>执行者<select name="executor"><option>未运行</option><option>用户本机</option><option>AI 执行环境</option><option>其他明确环境</option></select></label><label>复现状态<select name="reproduction"><option>未运行</option><option>已运行待核对</option><option>已复现</option></select></label></div><div class="failure-fields-grid failure-long-fields">{fields.map(([name,label,placeholder])=><label>{label}<textarea name={name} rows="4" maxlength="32000" placeholder={placeholder}></textarea></label>)}</div><p class="diagnostic-footnote">保存为私人草稿不会自动确认根因、标记学习完成或公开。公开与版本管理可在原学习工作台进行。</p><div class="failure-editor-actions"><button type="submit" id="failure-save" class="diagnostic-button">保存私人草稿</button><button type="button" id="failure-export-md" class="diagnostic-button diagnostic-button--quiet">导出 Markdown</button><button type="button" id="failure-export-json" class="diagnostic-button diagnostic-button--quiet">导出 JSON</button></div><p id="failure-status" role="status" aria-live="polite"></p></form></section>
  </div></div>
  <script type="application/json" id="failure-diagnostics-data" set:html={diagnosticData}></script>
</BaseLayout>
<script src="../../scripts/failure-review.ts"></script>
