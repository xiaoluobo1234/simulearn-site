---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicSearchIndex } from '../data/search-index';
import '../styles/search.css';

const domains = [ ['structural', '结构力学'], ['thermal', '热管理'], ['fluids', '流体'], ['multiphysics', '多物理场'], ['chip', '芯片仿真'], ['tools', '工具脚本'] ];
const recommendations = [
  { number: '01', title: '从领域知识开始', description: '从基本概念到模型假设，建立结构分析的知识路径。', href: '/domains/structural/', label: '结构力学' },
  { number: '02', title: '用代码处理工程问题', description: '查找 Python、NumPy、SciPy 与 APDL 的工具教程。', href: '/tools/', label: '工具脚本' },
  { number: '03', title: '先读懂一条报错', description: '按错误代码或求解器提示，找到排查的切入点。', href: '/errors/', label: '错误查询' },
  { number: '04', title: '在真实案例中串起来', description: '结合任务、方法与验证范围，理解工程判断过程。', href: '/cases/', label: '工程案例' },
];
const keywords = ['接触不收敛', '刚体位移', 'Python', 'CSV', 'ANSYS-004', '传热'];
const indexJson = JSON.stringify(publicSearchIndex).replace(/</g, '\\u003c');
---

<BaseLayout title="全站搜索" description="检索 SimuLearn 公开教程、报错代码、工程案例与站内页面，不搜索私人学习记录。" lang="zh" flush>
  <div class="search-page" data-search-page>
    <section class="search-hero">
      <div class="container-wide">
        <div class="search-breadcrumb"><a href="/">首页</a><span>/</span><span>全站搜索</span></div>
        <span class="search-eyebrow">KNOWLEDGE FINDER / 知识检索</span>
        <h1>全站搜索</h1>
        <p class="search-intro">从一个问题，找到下一步。查概念、找教程、定位报错。</p>
        <form id="searchForm" class="search-main-form" role="search" action="/search/" method="get">
          <label for="searchInput" class="search-sr-only">搜索公开知识与页面</label>
          <svg class="search-main-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
          <input id="searchInput" name="q" type="search" maxlength="120" placeholder="搜索知识点、报错代码或关键词…" autocomplete="off" spellcheck="false" aria-describedby="searchHint" aria-controls="searchResults" />
          <button id="searchClear" type="button" class="search-clear" aria-label="清除搜索关键词" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
          <button type="submit" class="search-submit">搜索 <span aria-hidden="true">→</span></button>
        </form>
        <div class="search-hero-foot"><p id="searchHint"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>仅检索公开内容，不搜索私人学习记录。</p><span>支持中文 / English / 错误代码</span></div>
      </div>
    </section>

    <section class="search-content-section">
      <div class="container-wide">
        <div class="search-filter-bar" id="searchFilters" aria-label="筛选搜索范围">
          <div class="search-filter-title"><span class="search-tiny-label">NARROW YOUR SEARCH</span><strong>缩小查找范围</strong></div>
          <div class="search-selects"><label for="searchDomain">学习领域<select id="searchDomain"><option value="">全部领域</option>{domains.map(([value,label]) => <option value={value}>{label}</option>)}</select></label><label for="searchType">内容类型<select id="searchType"><option value="">全部类型</option><option value="kp">教程知识点</option><option value="error">报错代码</option><option value="case">工程案例</option><option value="page">站内页面</option></select></label></div>
          <button class="search-text-button" type="button" data-search-reset hidden>清除筛选</button>
        </div>
        <div id="searchActiveFilters" class="search-active-filters" aria-label="当前筛选条件" hidden></div>
        <div class="search-results-heading"><h2 id="searchResultsTitle">公开知识，随时查找</h2><p id="searchStats" role="status" aria-live="polite" aria-atomic="true">正在准备搜索索引…</p></div>
        <section id="searchRecommendations" class="search-recommendations" aria-label="推荐入口">
          <div class="search-suggestions"><span>试试这些关键词</span><div>{keywords.map(word => <a href={`/search/?q=${encodeURIComponent(word)}`} data-search-keyword={word}>{word}<span aria-hidden="true">↗</span></a>)}</div></div>
          <div class="search-recommendation-grid">{recommendations.map(item => <a href={item.href} class="search-recommendation"><div><span class="search-recommendation-number">{item.number}</span><span class="search-recommendation-label">{item.label}</span></div><h3>{item.title}</h3><p>{item.description}</p><span class="search-recommendation-arrow" aria-hidden="true">↗</span></a>)}</div>
          <div class="search-index-note"><span class="search-tiny-label">PUBLIC INDEX</span><p>收录 {publicSearchIndex.length} 条公开内容。检索结果帮助你找到入口；学习状态与验证范围，以文章正文为准。</p></div>
        </section>
        <div id="searchResults" class="search-results" aria-label="搜索结果" aria-busy="false"></div>
        <div class="search-pagination" id="searchPagination" hidden><p id="searchShown"></p><button id="searchMore" type="button" class="search-load-more" aria-controls="searchResults">再显示 20 条 <span aria-hidden="true">↓</span></button></div>
        <noscript><div class="search-empty"><h3>搜索需要启用 JavaScript</h3><p>你仍可以使用上方推荐入口，按领域浏览公开内容。</p></div></noscript>
      </div>
    </section>
    <script type="application/json" id="searchIndexData" set:html={indexJson}></script>
  </div>
  <script>import '../scripts/search-page';</script>
</BaseLayout>
