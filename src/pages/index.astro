---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIcon from '../components/HomeIcon.astro';
import { siteConfig } from '../config';
import '../styles/home.css';

const shortcuts = [
  { icon: 'path', title: '知识路径', desc: '建立系统理解', href: '/learning' },
  { icon: 'case', title: '工程案例', desc: '查看实践与验证', href: '/cases' },
  { icon: 'diagnostic', title: '诊断系统', desc: '定位仿真问题', href: '/diagnostic' },
  { icon: 'tool', title: '计算工具', desc: '复用脚本与方法', href: '/tools' },
] as const;
const fields = [
  { slug:'structural', label:'结构', en:'Structural', desc:'有限元基础、结构动力学与结果验证', status:'实践沉淀', color:'#168d91' },
  { slug:'thermal', label:'热', en:'Thermal', desc:'热传导、散热设计与热应力', status:'持续学习', color:'#dd783c' },
  { slug:'fluids', label:'流体', en:'Fluids', desc:'流动基础、对流换热与流固耦合', status:'持续学习', color:'#398ace' },
  { slug:'multiphysics', label:'多物理场', en:'Multiphysics', desc:'场间耦合、数据传递与模型验证', status:'持续学习', color:'#9172ca' },
  { slug:'chip', label:'芯片仿真', en:'Chip Simulation', desc:'封装结构、热管理与可靠性', status:'探索中', color:'#c6902a' },
];
const method = [
  { icon:'book', title:'理解理论', desc:'建立概念与边界' },
  { icon:'model', title:'建立模型', desc:'选择方法与工具' },
  { icon:'check', title:'验证结果', desc:'分析误差与可信度' },
  { icon:'note', title:'沉淀方法', desc:'形成可复用的经验' },
] as const;
---

<BaseLayout lang="zh" flush>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-layout container-wide">
        <div class="hero-copy">
          <span class="hero-kicker">SIMULATION FIELD NOTES <i></i></span>
          <h1 id="home-title"><span class="hero-line">从结构有限元出发</span><span class="hero-line">走向<em>芯片多物理场仿真</em></span></h1>
          <p class="hero-description">记录经过实践与验证的知识路径、工程案例与诊断方法。<br class="desktop-break" />让仿真知识，成为解决问题的能力。</p>
          <div class="hero-actions"><a href="#domains" class="btn btn-primary hero-btn">开始学习 <span>→</span></a><a href="/cases" class="btn btn-ghost hero-btn">查看工程案例</a></div>
          <div class="hero-owner"><HomeIcon name="person" /><span><strong>{siteConfig.author}</strong><i>·</i>结构仿真工程师</span></div>
        </div>
        <figure class="hero-visual"><img src="/images/home/engineering-hero-v2.webp" alt="芯片与散热器、有限元网格、热流和流动线组合的工程概念插画" width="1474" height="1067" fetchpriority="high" /><figcaption>多物理场概念示意 · 非求解结果</figcaption></figure>
      </div>
    </section>

    <nav class="shortcut-wrap container-wide" aria-label="核心资源快捷入口"><div class="shortcut-bar">{shortcuts.map(item => <a href={item.href} class="shortcut"><span class="shortcut-icon"><HomeIcon name={item.icon} /></span><span class="shortcut-copy"><strong>{item.title}</strong><small>{item.desc}</small></span><span class="shortcut-arrow" aria-hidden="true">›</span></a>)}</div></nav>

    <section class="home-discovery container-wide" aria-labelledby="home-search-title">
      <div class="discovery-heading"><span>SEARCH YOUR QUESTION</span><h2 id="home-search-title">先找到要解决的问题</h2></div>
      <div class="discovery-search"><form action="/search" method="get" role="search" aria-label="首页站内搜索"><label for="home-search-input" class="home-search-label">搜索公开教程、案例与报错</label><div class="home-search-control"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="home-search-input" type="search" name="q" maxlength="120" placeholder="接触不收敛 / CSV / ANSYS-004" autocomplete="off" /><button type="submit">搜索 <span aria-hidden="true">→</span></button></div></form><div class="home-search-hints"><span>试试</span><a href="/search?q=CSV">CSV 文件读写</a><a href="/search?q=%E6%8E%A5%E8%A7%A6%E4%B8%8D%E6%94%B6%E6%95%9B">接触不收敛</a><a href="/search?q=%E5%9B%B4%E5%B2%A9">围岩案例</a><a class="all-search" href="/search">查看全部与筛选 ↗</a></div></div>
    </section>

    <div class="home-content container-wide">
      <section id="domains" class="domain-section" aria-labelledby="domain-title">
        <div class="section-heading"><div><span class="eyebrow">EXPLORE BY DOMAIN</span><h2 id="domain-title">从一个领域，走向完整的工程问题</h2></div><p>结构为起点，逐步贯通热、流体与多物理场。</p></div>
        <div class="domain-grid">{fields.map((field, index) => <a href={`/domains/${field.slug}`} class:list={['domain-card', { 'domain-card--featured': index === 0 }]} style={`--domain-color:${field.color}`}><div class="domain-art"><img src={`/images/home/domain-${field.slug}.svg`} width="240" height="140" alt="" loading="lazy" /></div><h3>{field.label}<small>{field.en}</small></h3><p>{field.desc}</p><div class="domain-bottom"><span class:list={['build-status', { 'build-status--active': index === 0, 'build-status--explore': index === 4 }]}>{field.status}</span><span class="domain-arrow" aria-hidden="true">→</span></div></a>)}</div>
        <p class="domain-note">以上为内容建设状态，个人学习进度由你在学习记录中独立维护。</p>
      </section>

      <section class="case-section" aria-labelledby="case-title">
        <div class="section-heading"><div><span class="eyebrow">FEATURED CASE · 工程实践</span><h2 id="case-title">把仿真结果，变成工程判断</h2></div><p>从具体的工程问题出发，展示数据如何转化为可解释的指标。</p></div>
        <article class="featured-case"><figure class="case-figure"><img src="/images/cases/energy-partition.png" alt="案例页已有的能量贡献图：展示不同高度层级的能量占比，完整保留坐标和图例" width="1800" height="1120" loading="lazy" /><figcaption><span class="figure-mark"></span>案例已有结果图 · 能量贡献占比</figcaption></figure><div class="case-copy"><div class="case-tags"><span>结构动力学</span><span>结果分析</span></div><h3>深部围岩卸荷动力响应<br /><span>从 26,100 行结果到可解释指标</span></h3><p>从批量工况与能量响应出发，梳理空间贡献、失稳指标和证据边界。</p><ol class="case-process"><li><span class="process-icon"><HomeIcon name="case" /></span>批量工况</li><li aria-hidden="true" class="process-arrow">→</li><li><span class="process-icon"><HomeIcon name="chart" /></span>能量响应</li><li aria-hidden="true" class="process-arrow">→</li><li><span class="process-icon"><HomeIcon name="diagnostic" /></span>诊断指标</li></ol><a class="case-link" href="/cases/rock-dynamic-stability">阅读完整案例 <span>→</span></a><p class="case-boundary">保留原案例的验证边界：原始工程与参数来源尚待补全。</p></div></article>
      </section>

      <aside class="learning-entry" aria-label="个人学习记录入口"><div><span class="entry-mark">↳</span><div><strong>把一次尝试，留成下一次学习的起点</strong><p>记录真实的问题、代码、结果与资料，学习记录默认私人草稿。</p></div></div><div class="learning-entry-actions"><a href="/learning">AI 工程学习总览 →</a><a href="/learning/records">写学习记录 ↗</a></div></aside>
    </div>

    <section class="method-strip" aria-label="工程学习方法"><div class="container-wide method-inner"><div class="method-heading"><h2>沿着工程问题，建立自己的知识路径</h2><p>从理论理解，到建模、验证与复用。</p></div><ol>{method.map((step,index) => <li><span class="method-icon"><HomeIcon name={step.icon} /></span><span><strong>{step.title}</strong><small>{step.desc}</small></span>{index < 3 && <span class="method-arrow" aria-hidden="true">→</span>}</li>)}</ol></div></section>
  </div>
</BaseLayout>
