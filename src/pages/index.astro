---
// 首页 - Chinese Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import ArticleCard from '../components/ArticleCard.astro';

// 这里后续会改为从 Markdown 文件自动读取
// For now, hardcoded sample articles
const recentPosts = [
  {
    title: '有限元分析入门：从理论到 ANSYS 实战',
    date: '2026-06-27',
    summary: '本文介绍有限元方法的基本思想，并通过 ANSYS Workbench 完成一个简支梁的静力学分析，帮助初学者建立从理论到软件的桥梁。',
    category: 'software-tutorial',
    categoryLabel: '软件教程',
    href: '/blog/first-post',
  },
  {
    title: '《有限元方法基础教程》读书笔记（第一章）',
    date: '2026-06-25',
    summary: 'Daryl L. Logan 的经典教材第一章笔记，涵盖弹簧单元、刚度矩阵的基本概念，以及直接刚度法的推导过程。',
    category: 'book-notes',
    categoryLabel: '读书笔记',
    href: '/blog/first-post',
  },
  {
    title: '网格划分对仿真精度的影响——我的踩坑记录',
    date: '2026-06-20',
    summary: '在一个支架应力分析项目中，我对比了不同网格密度和单元类型对结果的影响，记录了从"结果不收敛"到"结果合理"的全过程。',
    category: 'challenges',
    categoryLabel: '难点攻克',
    href: '/blog/first-post',
  },
];
---

<BaseLayout lang="zh">
  <!-- Hero Section -->
  <section class="hero container">
    <h1 class="hero-title">{siteConfig.title}</h1>
    <p class="hero-subtitle">{siteConfig.subtitle.zh}</p>
    <p class="hero-desc">{siteConfig.description.zh}</p>
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">浏览文章</a>
      <a href="/about" class="btn">了解更多</a>
    </div>
  </section>

  <!-- Categories -->
  <section class="categories container-wide">
    <h2 class="section-title">内容分类</h2>
    <div class="category-grid">
      {siteConfig.categories.zh.map((cat) => (
        <a href={`/blog?category=${cat.slug}`} class="category-card card">
          <h3>{cat.label}</h3>
          <p>{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="recent container-wide">
    <h2 class="section-title">最近文章</h2>
    <div class="card-grid">
      {recentPosts.map((post) => (
        <ArticleCard {...post} lang="zh" />
      ))}
    </div>
    <div class="section-more">
      <a href="/blog" class="btn">查看全部文章 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-3xl) 0;
    max-width: 640px;
  }

  .hero-title {
    font-size: 3rem;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
    margin-top: 0;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-lg);
    margin-top: 0;
    border: none;
    padding: 0;
  }

  .categories {
    margin: var(--space-3xl) auto;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
  }

  .category-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .category-card:hover {
    text-decoration: none;
  }

  .category-card h3 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-xs);
  }

  .category-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .recent {
    margin: var(--space-3xl) auto;
  }

  .section-more {
    text-align: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 600px) {
    .hero-title { font-size: 2.2rem; }
    .hero-subtitle { font-size: 1rem; }
    .category-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
