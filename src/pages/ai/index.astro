---
import BaseLayout from '../../layouts/BaseLayout.astro';

const datasetOptions = [
  { slug: 'structural', code: 'ST', label: '结构知识库' },
  { slug: 'thermal', code: 'TH', label: '热知识库' },
  { slug: 'fluids', code: 'FL', label: '流体知识库' },
  { slug: 'multiphysics', code: 'MP', label: '多物理场知识库' },
  { slug: 'chip', code: 'CH', label: '芯片仿真知识库' },
  { slug: 'private', code: 'PR', label: '私有原始资料库' },
];
---

<BaseLayout title="AI 知识库工作台" description="SimuLearn 私有 AI 知识库问答、资料整理与发布工作台。" lang="zh" flush>
  <section class="ai-header">
    <div class="container-wide ai-header-inner">
      <div>
        <span class="eyebrow">Owner workspace · Protected administrator access</span>
        <h1>AI 知识库工作台</h1>
        <p>检索已有知识、整理新资料、人工确认后再发布。模型负责辅助判断，最终公开决定由你完成。</p>
      </div>
      <div class="runtime-card">
        <div>
          <span class="runtime-dot"></span>
          <span data-runtime-label>正在检查接口</span>
        </div>
        <small data-runtime-detail>Cloudflare → Dify → DeepSeek</small>
      </div>
    </div>
  </section>

  <section class="security-bar">
    <div class="container-wide">
      <span class="shield-mark" aria-hidden="true">◇</span>
      <p><strong>默认私有：</strong>文件只在你确认后进入目标知识库。第三方论文和原始工程数据必须完成版权、脱敏与授权检查。</p>
      <a href="/about">数据规则 →</a>
    </div>
  </section>

  <section class="workspace-section">
    <div class="workspace container-wide">
      <aside class="workspace-nav">
        <div class="workspace-brand">
          <span>SL / AI</span>
          <strong>KNOWLEDGE OPS</strong>
        </div>
        <nav aria-label="AI 工作台导航">
          <button class="active" type="button" data-tab="chat">
            <span>01</span><b>知识问答</b><small>检索与来源</small>
          </button>
          <button type="button" data-tab="organize">
            <span>02</span><b>资料整理</b><small>分析与分类</small>
          </button>
          <button type="button" data-tab="review">
            <span>03</span><b>审核记录</b><small>当前会话</small>
          </button>
          <button type="button" data-tab="datasets">
            <span>04</span><b>知识库状态</b><small>文档与索引</small>
          </button>
        </nav>
        <div class="workspace-stack">
          <span>MODEL STACK</span>
          <p><b>DeepSeek</b> 生成与整理</p>
          <p><b>Qwen</b> Embedding / Rerank</p>
          <p><b>Dify</b> 检索与工作流</p>
        </div>
      </aside>

      <main class="workspace-main">
        <section class="workspace-panel active" data-panel="chat">
          <div class="panel-heading">
            <div><span>01 / KNOWLEDGE CHAT</span><h2>带来源的仿真问答</h2></div>
            <button type="button" class="quiet-button" data-new-chat>新对话</button>
          </div>

          <div class="chat-window" data-chat-window aria-live="polite">
            <article class="message message-assistant">
              <div class="message-role"><span>SL</span></div>
              <div>
                <span class="message-label">SIMULEARN AI</span>
                <p>我会优先检索知识库，再根据检索内容回答。没有足够证据时，我会明确说“不确定”，并列出仍需补充的资料。</p>
              </div>
            </article>
          </div>

          <div class="prompt-suggestions">
            <button type="button" data-prompt="如何系统检查结构瞬态分析的能量平衡？">检查结构瞬态能量平衡</button>
            <button type="button" data-prompt="热-结构单向耦合中，温度场映射需要验证哪些项目？">验证温度场映射</button>
            <button type="button" data-prompt="请根据知识库总结芯片封装仿真的学习顺序。">整理封装学习顺序</button>
          </div>

          <form class="chat-form" data-chat-form>
            <label for="knowledge-scope">检索范围</label>
            <select id="knowledge-scope" name="scope">
              <option value="all">全部公开知识库</option>
              {datasetOptions.slice(0, 5).map((dataset) => (
                <option value={dataset.slug}>{dataset.label}</option>
              ))}
            </select>
            <div class="query-box">
              <textarea name="query" rows="3" maxlength="4000" placeholder="提出一个需要依据资料回答的仿真问题……" required></textarea>
              <div>
                <span>回答将附带检索来源</span>
                <button class="send-button" type="submit">发送 <i>↗</i></button>
              </div>
            </div>
          </form>
        </section>

        <section class="workspace-panel" data-panel="organize">
          <div class="panel-heading">
            <div><span>02 / DOCUMENT ORGANIZER</span><h2>先整理，再决定是否发布</h2></div>
            <span class="format-note">PDF · DOCX · MD · TXT · CSV / ≤ 15 MB</span>
          </div>

          <div class="organize-grid">
            <div>
              <label class="drop-zone" data-drop-zone>
                <input type="file" accept=".pdf,.docx,.md,.markdown,.txt,.csv" data-file-input />
                <span class="drop-icon">＋</span>
                <strong>选择或拖入资料</strong>
                <p>文件不会自动公开。AI 只生成整理建议。</p>
                <small>扫描件 OCR 与复杂 Excel 将在第二阶段支持</small>
              </label>

              <div class="selected-file" data-selected-file hidden>
                <span class="file-type" data-file-type>DOC</span>
                <div><strong data-file-name></strong><small data-file-meta></small></div>
                <button type="button" data-clear-file>移除</button>
              </div>
              <button class="analyze-button" type="button" data-analyze disabled>
                <span>运行资料整理工作流</span><b>DeepSeek →</b>
              </button>
            </div>

            <div class="process-map">
              <span>REVIEW PIPELINE</span>
              <ol>
                <li class="active"><i>01</i><div><strong>文档提取</strong><small>Dify Document Extractor</small></div></li>
                <li><i>02</i><div><strong>摘要与分类</strong><small>DeepSeek</small></div></li>
                <li><i>03</i><div><strong>人工审核</strong><small>版权 · 脱敏 · 标签</small></div></li>
                <li><i>04</i><div><strong>向量索引</strong><small>Qwen Embedding / Rerank</small></div></li>
              </ol>
            </div>
          </div>

          <div class="analysis-result" data-analysis-result hidden>
            <div class="analysis-title">
              <div><span>AI ORGANIZATION DRAFT</span><h3>资料整理建议</h3></div>
              <span class="analysis-state">等待人工确认</span>
            </div>
            <div class="analysis-grid">
              <div class="summary-block"><small>摘要</small><p data-analysis-summary></p></div>
              <div><small>建议领域</small><strong data-analysis-category></strong></div>
              <div><small>建议标签</small><div class="tag-list" data-analysis-tags></div></div>
              <div class="risk-block"><small>敏感信息检查</small><p data-analysis-sensitivity></p></div>
              <div class="risk-block"><small>版权检查</small><p data-analysis-copyright></p></div>
            </div>

            <div class="approval-box">
              <div>
                <label for="target-dataset">确认目标知识库</label>
                <select id="target-dataset" data-target-dataset>
                  {datasetOptions.map((dataset) => (
                    <option value={dataset.slug}>{dataset.code} · {dataset.label}</option>
                  ))}
                </select>
              </div>
              <label class="check-line"><input type="checkbox" data-check-sensitive /><span>已检查并移除项目名称、客户、几何、载荷等敏感信息</span></label>
              <label class="check-line"><input type="checkbox" data-check-copyright /><span>已确认拥有公开权限；第三方论文只发布引用、摘要和个人笔记</span></label>
              <button type="button" class="publish-button" data-publish disabled>确认并进入知识库 <span>→</span></button>
            </div>
          </div>
        </section>

        <section class="workspace-panel" data-panel="review">
          <div class="panel-heading">
            <div><span>03 / SESSION LOG</span><h2>本次会话审核记录</h2></div>
            <small class="format-note">持久化文档记录在 Dify 管理端</small>
          </div>
          <div class="empty-state" data-review-empty>
            <span>00</span>
            <h3>还没有审核记录</h3>
            <p>完成一次资料分析或发布后，处理状态会出现在这里。</p>
            <button type="button" data-go-organize>开始整理资料</button>
          </div>
          <div class="review-list" data-review-list></div>
        </section>

        <section class="workspace-panel" data-panel="datasets">
          <div class="panel-heading">
            <div><span>04 / DATASET STATUS</span><h2>七个知识区的实时状态</h2></div>
            <button type="button" class="quiet-button" data-refresh-datasets>刷新</button>
          </div>
          <div class="dataset-summary">
            <div><span>知识区</span><strong data-total-datasets>—</strong></div>
            <div><span>文档</span><strong data-total-documents>—</strong></div>
            <div><span>可检索</span><strong data-total-available>—</strong></div>
            <div><span>总字数</span><strong data-total-words>—</strong></div>
          </div>
          <div class="dataset-grid" data-dataset-grid>
            <div class="loading-card">正在读取知识库状态……</div>
          </div>
        </section>
      </main>
    </div>
  </section>
</BaseLayout>

<script>
  type Analysis = {
    summary: string;
    category: string;
    categoryLabel: string;
    tags: string[];
    sensitivity: string;
    copyrightRisk: string;
  };

  const state: {
    file: File | null;
    analysis: Analysis | null;
    conversationId: string;
    reviewCount: number;
  } = { file: null, analysis: null, conversationId: '', reviewCount: 0 };

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const $$ = <T extends Element>(selector: string) => Array.from(document.querySelectorAll<T>(selector));
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  })[character] || character);

  async function api<T>(path: string, init?: RequestInit): Promise<T> {
    const response = await fetch(path, { credentials: 'same-origin', ...init });
    const body = await response.json().catch(() => ({ error: `接口返回 ${response.status}` }));
    if (!response.ok || body.ok === false) throw new Error(body.error || `请求失败（${response.status}）`);
    return body as T;
  }

  function activatePanel(name: string) {
    $$<HTMLButtonElement>('[data-tab]').forEach((button) => button.classList.toggle('active', button.dataset.tab === name));
    $$<HTMLElement>('[data-panel]').forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === name));
  }

  $$<HTMLButtonElement>('[data-tab]').forEach((button) => button.addEventListener('click', () => activatePanel(button.dataset.tab || 'chat')));
  $('[data-go-organize]')?.addEventListener('click', () => activatePanel('organize'));

  async function loadHealth() {
    const label = $('[data-runtime-label]');
    const detail = $('[data-runtime-detail]');
    try {
      const result = await api<{ mode: string; configured: Record<string, boolean> }>('/api/ai/health');
      if (label) label.textContent = result.mode === 'live' ? '实时知识库已连接' : '安全演示模式';
      if (detail) detail.textContent = result.mode === 'live'
        ? 'Cloudflare → Dify → DeepSeek'
        : '接口可用 · 尚未写入真实密钥';
      $('.runtime-dot')?.classList.add(result.mode === 'live' ? 'live' : 'mock');
    } catch (error) {
      if (label) label.textContent = '后端接口未启动';
      if (detail) detail.textContent = error instanceof Error ? error.message : '请使用 npm run dev:ai';
      $('.runtime-dot')?.classList.add('error');
    }
  }

  function addMessage(role: 'user' | 'assistant', text: string, sources: Array<Record<string, unknown>> = []) {
    const windowElement = $('[data-chat-window]');
    if (!windowElement) return;
    const article = document.createElement('article');
    article.className = `message message-${role}`;
    const sourceHtml = sources.length ? `
      <div class="source-list">
        <span>检索来源</span>
        ${sources.map((source, index) => `
          <div><b>${String(index + 1).padStart(2, '0')}</b><p><strong>${escapeHtml(source.document)}</strong><small>${escapeHtml(source.dataset)} · 相似度 ${Math.round(Number(source.score || 0) * 100)}%</small><span>${escapeHtml(source.excerpt)}</span></p></div>
        `).join('')}
      </div>` : '';
    article.innerHTML = `
      <div class="message-role"><span>${role === 'assistant' ? 'SL' : 'ME'}</span></div>
      <div><span class="message-label">${role === 'assistant' ? 'SIMULEARN AI' : 'YOU'}</span><p>${escapeHtml(text).replace(/\n/g, '<br>')}</p>${sourceHtml}</div>`;
    windowElement.append(article);
    article.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  const chatForm = $<HTMLFormElement>('[data-chat-form]');
  chatForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const textarea = chatForm.elements.namedItem('query') as HTMLTextAreaElement;
    const scope = (chatForm.elements.namedItem('scope') as HTMLSelectElement).value;
    const query = textarea.value.trim();
    if (!query) return;
    addMessage('user', query);
    textarea.value = '';
    const button = chatForm.querySelector<HTMLButtonElement>('[type="submit"]');
    if (button) { button.disabled = true; button.textContent = '检索中…'; }
    try {
      const result = await api<{ answer: string; conversationId: string; sources: Array<Record<string, unknown>> }>('/api/ai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, scope, conversationId: state.conversationId }),
      });
      state.conversationId = result.conversationId;
      addMessage('assistant', result.answer, result.sources);
    } catch (error) {
      addMessage('assistant', error instanceof Error ? error.message : '问答请求失败。');
    } finally {
      if (button) { button.disabled = false; button.innerHTML = '发送 <i>↗</i>'; }
    }
  });

  $$<HTMLButtonElement>('[data-prompt]').forEach((button) => button.addEventListener('click', () => {
    const textarea = chatForm?.elements.namedItem('query') as HTMLTextAreaElement | null;
    if (textarea) { textarea.value = button.dataset.prompt || ''; textarea.focus(); }
  }));

  $('[data-new-chat]')?.addEventListener('click', () => {
    state.conversationId = '';
    const chatWindow = $('[data-chat-window]');
    chatWindow?.querySelectorAll('.message:not(:first-child)').forEach((message) => message.remove());
  });

  function selectFile(file: File | null) {
    state.file = file;
    state.analysis = null;
    const selected = $<HTMLElement>('[data-selected-file]');
    const analyze = $<HTMLButtonElement>('[data-analyze]');
    const result = $<HTMLElement>('[data-analysis-result]');
    if (result) result.hidden = true;
    if (!file) {
      if (selected) selected.hidden = true;
      if (analyze) analyze.disabled = true;
      return;
    }
    if (selected) selected.hidden = false;
    const name = $('[data-file-name]');
    const meta = $('[data-file-meta]');
    const type = $('[data-file-type]');
    if (name) name.textContent = file.name;
    if (meta) meta.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB · 等待分析`;
    if (type) type.textContent = file.name.split('.').pop()?.toUpperCase() || 'DOC';
    if (analyze) analyze.disabled = false;
  }

  const fileInput = $<HTMLInputElement>('[data-file-input]');
  fileInput?.addEventListener('change', () => selectFile(fileInput.files?.[0] || null));
  $('[data-clear-file]')?.addEventListener('click', () => {
    if (fileInput) fileInput.value = '';
    selectFile(null);
  });

  const dropZone = $<HTMLElement>('[data-drop-zone]');
  dropZone?.addEventListener('dragover', (event) => { event.preventDefault(); dropZone.classList.add('dragging'); });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('dragging'));
  dropZone?.addEventListener('drop', (event) => {
    event.preventDefault();
    dropZone.classList.remove('dragging');
    selectFile(event.dataTransfer?.files?.[0] || null);
  });

  function renderAnalysis(analysis: Analysis) {
    const result = $<HTMLElement>('[data-analysis-result]');
    if (!result) return;
    result.hidden = false;
    const summary = $('[data-analysis-summary]');
    const category = $('[data-analysis-category]');
    const sensitivity = $('[data-analysis-sensitivity]');
    const copyright = $('[data-analysis-copyright]');
    if (summary) summary.textContent = analysis.summary;
    if (category) category.textContent = analysis.categoryLabel;
    if (sensitivity) sensitivity.textContent = analysis.sensitivity;
    if (copyright) copyright.textContent = analysis.copyrightRisk;
    const tags = $('[data-analysis-tags]');
    if (tags) tags.innerHTML = analysis.tags.map((tag) => `<span>${escapeHtml(tag)}</span>`).join('');
    const target = $<HTMLSelectElement>('[data-target-dataset]');
    if (target && Array.from(target.options).some((option) => option.value === analysis.category)) target.value = analysis.category;
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('[data-analyze]')?.addEventListener('click', async () => {
    const button = $<HTMLButtonElement>('[data-analyze]');
    if (!state.file || !button) return;
    button.disabled = true;
    button.innerHTML = '<span>正在提取并分析资料……</span><b>请稍候</b>';
    const form = new FormData();
    form.set('file', state.file, state.file.name);
    try {
      const result = await api<{ analysis: Analysis }>('/api/ai/analyze', { method: 'POST', body: form });
      state.analysis = result.analysis;
      renderAnalysis(result.analysis);
    } catch (error) {
      window.alert(error instanceof Error ? error.message : '资料分析失败。');
    } finally {
      button.disabled = false;
      button.innerHTML = '<span>重新运行整理工作流</span><b>DeepSeek →</b>';
    }
  });

  function updatePublishState() {
    const sensitive = $<HTMLInputElement>('[data-check-sensitive]')?.checked;
    const copyright = $<HTMLInputElement>('[data-check-copyright]')?.checked;
    const button = $<HTMLButtonElement>('[data-publish]');
    if (button) button.disabled = !(sensitive && copyright && state.file && state.analysis);
  }
  $('[data-check-sensitive]')?.addEventListener('change', updatePublishState);
  $('[data-check-copyright]')?.addEventListener('change', updatePublishState);

  function addReviewItem(filename: string, dataset: string, status: string, batch: string) {
    state.reviewCount += 1;
    const empty = $<HTMLElement>('[data-review-empty]');
    if (empty) empty.hidden = true;
    const list = $('[data-review-list]');
    if (!list) return;
    const item = document.createElement('article');
    item.className = 'review-item';
    item.dataset.batch = batch;
    item.innerHTML = `
      <span class="review-index">${String(state.reviewCount).padStart(2, '0')}</span>
      <div><strong>${escapeHtml(filename)}</strong><small>${escapeHtml(dataset)}</small></div>
      <span class="review-status"><i></i>${escapeHtml(status)}</span>`;
    list.prepend(item);
  }

  $('[data-publish]')?.addEventListener('click', async () => {
    const button = $<HTMLButtonElement>('[data-publish]');
    const target = $<HTMLSelectElement>('[data-target-dataset]');
    if (!button || !target || !state.file) return;
    button.disabled = true;
    button.textContent = '正在创建索引……';
    const form = new FormData();
    form.set('file', state.file, state.file.name);
    form.set('dataset', target.value);
    try {
      const response = await api<{ batch: string; dataset: { slug: string; name: string }; document: { indexingStatus: string } }>('/api/ai/publish', {
        method: 'POST',
        body: form,
      });
      addReviewItem(state.file.name, response.dataset.name, response.document.indexingStatus, response.batch);
      window.alert('文件已进入目标知识库，Dify 正在分段并生成向量索引。');
      activatePanel('review');
      await loadDatasets();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : '发布失败。');
    } finally {
      button.disabled = false;
      button.innerHTML = '确认并进入知识库 <span>→</span>';
    }
  });

  function formatNumber(value: number) {
    return new Intl.NumberFormat('zh-CN', { notation: value > 99999 ? 'compact' : 'standard', maximumFractionDigits: 1 }).format(value);
  }

  async function loadDatasets() {
    const grid = $('[data-dataset-grid]');
    if (!grid) return;
    grid.innerHTML = '<div class="loading-card">正在读取知识库状态……</div>';
    try {
      const result = await api<{ datasets: Array<{ slug: string; name: string; documents: number; available: number; words: number; updatedAt: string | null }> }>('/api/ai/datasets');
      const datasets = result.datasets;
      const totalDocuments = datasets.reduce((sum, item) => sum + Number(item.documents || 0), 0);
      const totalAvailable = datasets.reduce((sum, item) => sum + Number(item.available || 0), 0);
      const totalWords = datasets.reduce((sum, item) => sum + Number(item.words || 0), 0);
      const setText = (selector: string, value: string) => { const element = $(selector); if (element) element.textContent = value; };
      setText('[data-total-datasets]', String(datasets.length));
      setText('[data-total-documents]', formatNumber(totalDocuments));
      setText('[data-total-available]', formatNumber(totalAvailable));
      setText('[data-total-words]', formatNumber(totalWords));
      grid.innerHTML = datasets.map((item, index) => `
        <article>
          <div><span>${String(index + 1).padStart(2, '0')}</span><i class="${item.slug === 'private' || item.slug === 'review' ? 'private' : ''}">${item.slug === 'private' || item.slug === 'review' ? '私有' : '公开'}</i></div>
          <h3>${escapeHtml(item.name)}</h3>
          <div class="dataset-metrics"><span><b>${formatNumber(item.documents)}</b>文档</span><span><b>${formatNumber(item.available)}</b>可检索</span><span><b>${formatNumber(item.words)}</b>字</span></div>
          <small>更新 ${escapeHtml(item.updatedAt || '—')}</small>
        </article>`).join('');
    } catch (error) {
      grid.innerHTML = `<div class="loading-card error">${escapeHtml(error instanceof Error ? error.message : '读取失败')}</div>`;
    }
  }

  $('[data-refresh-datasets]')?.addEventListener('click', loadDatasets);
  loadHealth();
  loadDatasets();
</script>

<style>
  .ai-header { padding: 4.2rem 0 3.6rem; color: #b2c6c7; background: radial-gradient(circle at 82% 20%, rgba(18,175,163,.18), transparent 27%), var(--color-primary-deep); }
