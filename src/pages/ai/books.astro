---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="发布工程书籍" description="管理员上传 MinerU 已解析的 Markdown 或 JSON，发布章节化工程电子书。" lang="zh">
  <section class="admin-hero">
    <div class="container">
      <a href="/ai">← 返回 AI 工作台</a>
      <span>ADMIN / MANUAL BOOK IMPORT</span>
      <h1>发布已解析的工程书籍</h1>
      <p>上传 MinerU 已解析的 Markdown 或 JSON 文档，外部图片自动下载到 R2 永久存储。</p>
    </div>
  </section>

  <section class="container admin-grid">
    <form class="panel import-form" data-import-form>
      <div class="panel-heading">
        <div>
          <span>01 / SOURCE</span>
          <h2>解析结果</h2>
        </div>
        <small>文档不超过 50 MB</small>
      </div>

      <label class="drop">
        <input type="file" name="document" accept=".md,.markdown,.json,application/json,text/markdown" required data-document />
        <strong data-document-label>选择 Markdown 或 JSON 文档</strong>
        <span>Markdown 按标题自动分章；JSON 可直接提供 chapters 数组。外部图片自动下载到 R2。</span>
      </label>

      <div class="panel-heading">
        <div>
          <span>02 / METADATA</span>
          <h2>书籍信息</h2>
        </div>
      </div>
      <div class="two">
        <label>书名<input name="title" required maxlength="200" /></label>
        <label>作者<input name="author" maxlength="300" /></label>
      </div>
      <div class="three">
        <label>出版社<input name="publisher" maxlength="300" /></label>
        <label>出版年份<input name="year" /></label>
        <label>页数<input name="pageCount" type="number" min="1" /></label>
      </div>
      <label>简介<textarea name="description" rows="4" maxlength="4000"></textarea></label>
      <label>本书导读（可选）<textarea name="guide" rows="5" maxlength="12000" placeholder="由管理员填写；不会改动正文。"></textarea></label>
      <div class="two">
        <label>固定 URL 标识
          <input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="finite-element-basics" />
        </label>
        <label>所属领域
          <select name="targetDataset" required>
            <option value="structural">结构</option>
            <option value="thermal">热</option>
            <option value="fluids">流体</option>
            <option value="multiphysics">多物理场</option>
            <option value="chip">芯片仿真</option>
          </select>
        </label>
      </div>
      <label class="check"><input type="checkbox" name="overwrite" />相同 URL 已存在时覆盖旧版本</label>
      <label class="check"><input type="checkbox" required />我确认拥有处理和公开该内容及图片的合法权限</label>

      <button class="primary" type="submit" data-submit>发布到工程书库 <span>→</span></button>
      <div class="result" data-result hidden></div>
    </form>

    <aside class="panel guide-panel">
      <span>IMPORT FORMAT</span>
      <h2>导入说明</h2>
      <p>上传 MinerU 解析的 Markdown 文档，书名、作者、简介等元信息会自动提取。外部图片（HTTPS）在导入时自动下载到 R2 永久存储。</p>
      <pre>![应力云图](https://example.com/stress.jpg)

$$
K u = f
$$</pre>
      <h3>JSON 最小格式</h3>
      <pre>&#123;
  "meta": &#123;
    "title": "书名",
    "author": "作者"
  &#125;,
  "chapters": [
    &#123;
      "title": "第一章",
      "markdown": "# 第一章\n正文"
    &#125;
  ]
&#125;</pre>
      <p>公式由阅读页的 MathJax 渲染；Markdown/JSON 正文不会经过大模型改写。</p>
    </aside>
  </section>

  <section class="container admin-grid" style="margin-top:2rem">
    <div class="panel sync-panel" data-sync-panel>
      <div class="panel-heading">
        <div>
          <span>03 / DIFY SYNC</span>
          <h2>同步到 AI 知识库</h2>
        </div>
        <small>将已发布书籍推入「工程书库」知识库，AI 问答即可检索</small>
      </div>

      <div class="sync-controls">
        <label>选择书籍
          <select name="syncSlug" data-sync-slug>
            <option value="">— 请先加载书库列表 —</option>
          </select>
        </label>
        <button class="primary sync-btn" type="button" data-sync-btn disabled>同步到 Dify 知识库</button>
      </div>

      <div class="sync-status" data-sync-status hidden>
        <div class="sync-progress" data-sync-progress></div>
        <div class="sync-result" data-sync-result></div>
      </div>
    </div>

    <aside class="panel guide-panel">
      <span>SYNC GUIDE</span>
      <h2>同步说明</h2>
      <p>书籍发布到 R2 后不会自动进入 AI 检索范围。点击「同步到 Dify 知识库」将书籍章节逐段推入「SimuLearn｜工程书库」知识库。</p>
      <h3>同步规则</h3>
      <ul style="padding-left:1.2rem;color:#a9c0c8;font-size:.85rem;line-height:1.7">
        <li>按章节逐段推入，每章一个独立文档</li>
        <li>已同步的章节自动跳过，不会重复</li>
        <li>同步后 AI 问答即可检索书籍内容</li>
        <li>大书可能耗时较长，请耐心等待</li>
      </ul>
      <h3>前提条件</h3>
      <p>需先在 Dify 控制台创建「SimuLearn｜工程书库」知识库，并将其 UUID 填入 <code>DIFY_DATASETS_JSON</code> 的 <code>books</code> 字段。</p>
    </aside>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-import-form]');
  const documentInput = document.querySelector<HTMLInputElement>('[data-document]');
  const documentLabel = document.querySelector<HTMLElement>('[data-document-label]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const result = document.querySelector<HTMLElement>('[data-result]');

  const slugify = (value: string) => value
    .replace(/\.(md|markdown|json)$/i, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '') || `book-${new Date().toISOString().slice(0, 10)}`;

  function fillField(name: string, value: unknown) {
    const field = form?.elements.namedItem(name);
    if ((field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) && value && !field.value) {
      field.value = String(value);
    }
  }

  function extractMarkdownMetadata(text: string): Record<string, string> {
    const meta: Record<string, string> = {};
    const titleMatch = text.match(/^#\s+(.+)$/m);
    if (titleMatch) meta.title = titleMatch[1].trim();
    if (titleMatch) {
      const afterTitle = text.slice(titleMatch.index! + titleMatch[0].length);
      const authorMatch = afterTitle.match(/^\s*([^\n]+?)\s*(?:编著|著|编|译)\s*(?:$|\n)/m);
      if (authorMatch) meta.author = authorMatch[1].trim();
    }
    const cipMatch = text.match(/[\u4e00-\u9fff]+\/([^\n]+?)(?:编著|著|编|译)[^\n]*?[—-]\s*[^：]+：([^，]+)，(\d{4})/);
    if (cipMatch) {
      if (!meta.author) meta.author = cipMatch[1].trim();
      meta.publisher = cipMatch[2].trim();
      meta.year = cipMatch[3];
    }
    const isbnMatch = text.match(/ISBN\s+([\d-]+)/);
    if (isbnMatch) meta.isbn = isbnMatch[1];
    const descMatch = text.match(/##\s*内容简介\s*([\s\S]*?)(?=\n##\s|$)/);
    if (descMatch) meta.description = descMatch[1].trim().replace(/\\n/g, ' ').replace(/\n+/g, ' ').slice(0, 4000);
    return meta;
  }

  documentInput?.addEventListener('change', async () => {
    const file = documentInput.files?.[0];
    if (!file) return;
    if (documentLabel) documentLabel.textContent = `${file.name} · ${(file.size / 1048576).toFixed(2)} MB`;
    const text = await file.text();
    if (file.name.toLowerCase().endsWith('.json')) {
      try {
        const parsed = JSON.parse(text);
        const metadata = parsed.meta || parsed.metadata || {};
        const values: Record<string, unknown> = {
          title: metadata.title, author: metadata.author, publisher: metadata.publisher,
          year: metadata.year, pageCount: metadata.pageCount, description: metadata.description,
          guide: metadata.guide || parsed.guide, isbn: metadata.isbn,
        };
        Object.entries(values).forEach(([name, value]) => fillField(name, value));
      } catch { /* Server validation will provide the exact JSON error on submit. */ }
      const slug = form?.elements.namedItem('slug');
      if (slug instanceof HTMLInputElement && !slug.value) slug.value = slugify(file.name);
      return;
    }
    const meta = extractMarkdownMetadata(text);
    const title = meta.title || file.name.replace(/\.(md|markdown)$/i, '');
    fillField('title', title);
    fillField('author', meta.author);
    fillField('publisher', meta.publisher);
    fillField('year', meta.year);
    fillField('isbn', meta.isbn);
    fillField('description', meta.description);
    const slug = form?.elements.namedItem('slug');
    if (slug instanceof HTMLInputElement && !slug.value) slug.value = slugify(title);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submit || !result) return;
    const body = new FormData(form);
    body.delete('assets');
    body.delete('assetPaths');
    body.set('overwrite', body.get('overwrite') === 'on' ? 'true' : 'false');
    const docSize = documentInput?.files?.[0]?.size || 0;
    if (docSize > 50 * 1024 * 1024) {
      window.alert('文档不能超过 50 MB。');
      return;
    }
    submit.disabled = true;
    submit.textContent = '正在上传并下载外部图片……';
    result.hidden = true;
    try {
      const response = await fetch('/api/ai/books/import', {
        method: 'POST',
        credentials: 'same-origin',
        body,
      });
      const payload = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
      if (!response.ok || payload.ok === false) throw new Error(payload.error || `HTTP ${response.status}`);
      result.hidden = false;
      result.innerHTML = `<strong>发布完成</strong><a href="${payload.url}">打开书籍 →</a>${
        payload.warnings?.length ? `<p>${payload.warnings.join('；')}</p>` : ''
      }`;
    } catch (error) {
      result.hidden = false;
      result.textContent = error instanceof Error ? error.message : '发布失败';
    } finally {
      submit.disabled = false;
      submit.innerHTML = '发布到工程书库 <span>→</span>';
    }
  });
</script>

<script>
  // ── Book sync to Dify knowledge base ──
  const syncPanel = document.querySelector<HTMLElement>('[data-sync-panel]');
  const syncSlug = document.querySelector<HTMLSelectElement>('[data-sync-slug]');
  const syncBtn = document.querySelector<HTMLButtonElement>('[data-sync-btn]');
  const syncStatus = document.querySelector<HTMLElement>('[data-sync-status]');
  const syncProgress = document.querySelector<HTMLElement>('[data-sync-progress]');
  const syncResult = document.querySelector<HTMLElement>('[data-sync-result]');

  async function loadBookList() {
    if (!syncSlug) return;
    try {
      const res = await fetch('/api/books', { credentials: 'same-origin' });
      const data = await res.json();
      const books: Array<{ slug: string; title: string; chapterCount: number }> = data.books || [];
      syncSlug.innerHTML = '<option value="">— 选择要同步的书籍 —</option>'
        + books.map((b) => `<option value="${b.slug}">${b.title}（${b.chapterCount} 章）</option>`).join('');
      syncSlug.addEventListener('change', () => {
        if (syncBtn) syncBtn.disabled = !syncSlug.value;
      });
    } catch {
      syncSlug.innerHTML = '<option value="">加载书库列表失败</option>';
    }
  }

  loadBookList();

  syncBtn?.addEventListener('click', async () => {
    const slug = syncSlug?.value;
    if (!slug || !syncBtn || !syncStatus || !syncProgress || !syncResult) return;

    syncBtn.disabled = true;
    syncBtn.textContent = '正在同步……';
    syncStatus.hidden = false;
    syncProgress.innerHTML = '<p>正在将书籍章节推入 Dify 知识库，请稍候……</p>';
    syncResult.innerHTML = '';

    try {
      const res = await fetch(`/api/ai/books/${encodeURIComponent(slug)}/sync`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);

      syncProgress.innerHTML = '';
      syncResult.innerHTML = `
        <strong>同步完成</strong>
        <p>书名：${data.bookTitle}</p>
        <p>共 ${data.chapterCount} 章：同步 ${data.synced} 章，跳过 ${data.skipped} 章（已存在），失败 ${data.failed} 章</p>
        ${data.errors?.length ? `<p style="color:#c0392b">错误：${data.errors.join('；')}</p>` : ''}
        ${data.synced > 0 ? '<p>✅ 同步完成后，AI 问答即可检索本书内容。</p>' : ''}
      `;
    } catch (error) {
      syncProgress.innerHTML = '';
      syncResult.innerHTML = `<p style="color:#c0392b">同步失败：${error instanceof Error ? error.message : '未知错误'}</p>`;
    } finally {
      syncBtn.disabled = false;
      syncBtn.textContent = '同步到 Dify 知识库';
    }
  });
</script>

<style>
  .admin-hero { padding: 4.5rem 0 3.5rem; color: white; background: var(--color-primary); }
  .admin-hero a { color: var(--color-accent-light); }
  .admin-hero span, .panel-heading span, .guide-panel > span { display: block; margin-top: 1.5rem; font: 600 .7rem/1 var(--font-mono); letter-spacing: .14em; color: var(--color-accent-light); }
  .admin-hero h1 { margin: .8rem 0; font-size: clamp(2.3rem, 5vw, 4rem); }
  .admin-hero p { max-width: 780px; color: #bdd0d7; }
  .admin-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 1.5rem; padding-block: 2.5rem 5rem; }
  .panel { padding: 1.6rem; border: 1px solid var(--color-border); background: white; box-shadow: var(--shadow-sm); }
  .panel-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: .5rem 0 1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--color-border); }
  .panel-heading span { margin: 0; color: var(--color-accent); }
  .panel-heading h2 { margin: .35rem 0 0; }
  .panel-heading small { color: var(--color-text-secondary); }
  .import-form { display: grid; gap: 1rem; }
  .import-form label { display: grid; gap: .42rem; font-size: .82rem; color: var(--color-text-secondary); }
  .import-form input, .import-form textarea, .import-form select { width: 100%; padding: .8rem; border: 1px solid var(--color-border); background: white; font: inherit; color: var(--color-text); }
  .two, .three { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .three { grid-template-columns: 1.5fr .75fr .75fr; }
  .drop { min-height: 150px; place-content: center; text-align: center; border: 1px dashed #8aa8ae; background: #f5f9f8; cursor: pointer; }
  .drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .drop strong { color: var(--color-primary); font-size: 1rem; }
  .drop span { max-width: 540px; color: var(--color-text-secondary); }
  .check { display: flex !important; grid-template-columns: auto 1fr; align-items: center; }
  .check input { width: auto; }
  .primary { padding: 1rem 1.2rem; border: 0; color: white; background: var(--color-accent); font-weight: 700; cursor: pointer; }
  .primary:disabled { opacity: .6; cursor: wait; }
  .result { padding: 1rem; border: 1px solid var(--color-accent); background: #effaf8; }
  .result strong, .result a { display: block; }
  .result a { margin-top: .5rem; }
  .guide-panel { align-self: start; position: sticky; top: 90px; background: #071723; color: #d9e8eb; }
  .guide-panel > span { margin: 0; }
  .guide-panel h2, .guide-panel h3 { color: white; }
  .guide-panel p { color: #a9c0c8; font-size: .85rem; }
  .guide-panel pre { overflow-x: auto; padding: 1rem; background: #0e2938; color: #b7eee9; font-size: .75rem; white-space: pre-wrap; }
  .guide-panel code { color: #8de3dc; }
  .sync-panel { display: grid; gap: 1rem; }
  .sync-controls { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end; }
  .sync-controls label { display: grid; gap: .42rem; font-size: .82rem; color: var(--color-text-secondary); }
  .sync-controls select { padding: .8rem; border: 1px solid var(--color-border); background: white; font: inherit; }
  .sync-btn { align-self: end; }
  .sync-status { padding: 1rem; border: 1px solid var(--color-border); background: #fafafa; }
  .sync-progress { color: var(--color-text-secondary); font-size: .85rem; }
  .sync-result strong { display: block; margin-bottom: .4rem; color: var(--color-primary); }
  .sync-result p { margin: .3rem 0; font-size: .85rem; }
  @media (max-width: 620px) {
    .sync-controls { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .admin-grid { grid-template-columns: 1fr; }
    .guide-panel { position: static; }
  }
  @media (max-width: 620px) {
    .two, .three { grid-template-columns: 1fr; }
  }
</style>
