---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="上传书籍" description="管理员上传 PDF，确认元数据并追踪 MinerU 解析与 Dify 入库状态。" lang="zh">
  <section class="admin-hero">
    <div class="container">
      <a href="/ai">← 返回 AI 工作台</a>
      <span>ADMIN / BOOK INGESTION</span>
      <h1>PDF 整书入库与重构学习</h1>
      <p>正文不由模型改写。MinerU 负责保真解析，模型只生成单独的导读和章节摘要。</p>
    </div>
  </section>
  <section class="container admin-grid">
    <div class="panel">
      <h2>1. 上传 PDF</h2>
      <p class="hint">硬限制：PDF、≤ 50 MB、≤ 200 页。8 GiB 服务器默认使用远程 MinerU 服务。</p>
      <label class="drop">
        <input type="file" accept="application/pdf,.pdf" data-book-file />
        <strong data-file-label>选择一本工程或仿真类 PDF</strong>
        <span>上传后先提取元数据，再由你确认是否正式解析。</span>
      </label>
      <button class="primary" type="button" data-upload disabled>上传并提取元数据</button>
      <div class="progress" data-upload-progress hidden><i></i><span>正在上传……</span></div>
    </div>
    <div class="panel confirm" data-confirm hidden>
      <h2>2. 确认书籍信息</h2>
      <form data-confirm-form>
        <label>书名<input name="title" required maxlength="200" /></label>
        <div class="two"><label>作者<input name="author" /></label><label>出版年份<input name="year" /></label></div>
        <label>出版社<input name="publisher" /></label>
        <label>简介<textarea name="description" rows="4" maxlength="2000"></textarea></label>
        <div class="two">
          <label>固定 URL 标识<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /></label>
          <label>目标知识库
            <select name="targetDataset" required>
              <option value="structural">结构</option><option value="thermal">热</option>
              <option value="fluids">流体</option><option value="multiphysics">多物理场</option>
              <option value="chip">芯片仿真</option>
            </select>
          </label>
        </div>
        <label class="check"><input type="checkbox" name="overwrite" />同一 URL 已存在时覆盖旧版本</label>
        <label class="check"><input type="checkbox" required />我确认拥有处理和发布该书的合法权限</label>
        <button class="primary" type="submit">提交入库任务</button>
      </form>
    </div>
    <div class="panel history">
      <div class="heading"><h2>历史任务</h2><button type="button" data-refresh>刷新</button></div>
      <div data-jobs><p class="hint">正在读取……</p></div>
    </div>
  </section>
</BaseLayout>

<script>
  type Job = {
    id: string; filename: string; status: string; progress: number; stage: string; updatedAt: string;
    metadata: { title: string; author: string; publisher: string; year: string; description: string; pageCount?: number };
    slug?: string; targetDataset?: string; overwrite?: boolean; error?: string; result?: { url: string };
  };
  const fileInput = document.querySelector<HTMLInputElement>('[data-book-file]');
  const uploadButton = document.querySelector<HTMLButtonElement>('[data-upload]');
  const fileLabel = document.querySelector<HTMLElement>('[data-file-label]');
  const progress = document.querySelector<HTMLElement>('[data-upload-progress]');
  const confirm = document.querySelector<HTMLElement>('[data-confirm]');
  const form = document.querySelector<HTMLFormElement>('[data-confirm-form]');
  const jobsRoot = document.querySelector<HTMLElement>('[data-jobs]');
  let activeJob: Job | null = null;
  let selectedFile: File | null = null;
  const terminal = new Set(['done', 'failed', 'awaiting_confirmation']);
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  })[character] || character);

  async function request(path: string, init?: RequestInit) {
    const response = await fetch(path, { credentials: 'same-origin', ...init });
    const body = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
    if (!response.ok || body.ok === false) throw new Error(body.error || `HTTP ${response.status}`);
    return body;
  }

  function defaultSlug(filename: string) {
    const ascii = filename.replace(/\.pdf$/i, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    return ascii || `book-${new Date().toISOString().slice(0, 10)}`;
  }

  function fillForm(job: Job) {
    if (!form) return;
    activeJob = job;
    const values: Record<string, string> = {
      title: job.metadata.title || job.filename.replace(/\.pdf$/i, ''),
      author: job.metadata.author || '', publisher: job.metadata.publisher || '',
      year: job.metadata.year || '', description: job.metadata.description || '',
      slug: job.slug || defaultSlug(job.filename), targetDataset: job.targetDataset || 'structural',
    };
    Object.entries(values).forEach(([name, value]) => {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) field.value = value;
    });
    confirm!.hidden = false;
    confirm!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  fileInput?.addEventListener('change', () => {
    selectedFile = fileInput.files?.[0] || null;
    if (selectedFile && selectedFile.size > 50 * 1024 * 1024) {
      alert('PDF 不能超过 50 MB。');
      selectedFile = null;
      fileInput.value = '';
    }
    if (selectedFile && !selectedFile.name.toLowerCase().endsWith('.pdf')) {
      alert('只允许 PDF 文件。'); selectedFile = null; fileInput.value = '';
    }
    if (fileLabel) fileLabel.textContent = selectedFile ? `${selectedFile.name} · ${(selectedFile.size / 1048576).toFixed(2)} MB` : '选择一本工程或仿真类 PDF';
    if (uploadButton) uploadButton.disabled = !selectedFile;
  });

  uploadButton?.addEventListener('click', async () => {
    if (!selectedFile || !uploadButton) return;
    uploadButton.disabled = true;
    if (progress) progress.hidden = false;
    try {
      const created = await request('/api/ai/books/jobs', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename: selectedFile.name, size: selectedFile.size }),
      });
      await request(created.uploadUrl, {
        method: 'PUT', headers: { 'Content-Type': 'application/pdf' },
        body: selectedFile,
      });
      activeJob = created.job;
      await loadJobs();
      pollJob(created.job.id);
    } catch (error) {
      alert(error instanceof Error ? error.message : '上传失败');
    } finally {
      uploadButton.disabled = false;
      if (progress) progress.hidden = true;
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!activeJob) return;
    const data = new FormData(form);
    try {
      const result = await request(`/api/ai/books/jobs/${activeJob.id}`, {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          metadata: {
            title: data.get('title'), author: data.get('author'), publisher: data.get('publisher'),
            year: data.get('year'), description: data.get('description'),
          },
          slug: data.get('slug'), targetDataset: data.get('targetDataset'), overwrite: data.get('overwrite') === 'on',
        }),
      });
      activeJob = result.job;
      confirm!.hidden = true;
      await loadJobs();
      pollJob(result.job.id);
    } catch (error) {
      alert(error instanceof Error ? error.message : '提交失败');
    }
  });

  async function pollJob(id: string) {
    try {
      const result = await request(`/api/ai/books/jobs/${id}`);
      const job = result.job as Job;
      if (job.status === 'awaiting_confirmation' && (!activeJob || activeJob.id === id)) fillForm(job);
      await loadJobs();
      if (!terminal.has(job.status)) setTimeout(() => pollJob(id), 5000);
    } catch { /* 手动刷新仍可恢复 */ }
  }

  async function loadJobs() {
    if (!jobsRoot) return;
    try {
      const result = await request('/api/ai/books/jobs');
      const jobs = result.jobs as Job[];
      jobsRoot.innerHTML = jobs.length ? jobs.map((job) => `
        <article class="job">
          <div><strong>${escapeHtml(job.metadata.title || job.filename)}</strong><small>${escapeHtml(job.id)}</small></div>
          <div class="job-stage"><span>${escapeHtml(job.stage)}</span><progress max="100" value="${job.progress || 0}"></progress></div>
          <b class="status status-${escapeHtml(job.status)}">${escapeHtml(job.status)}</b>
          ${job.error ? `<p class="job-error">${escapeHtml(job.error)}</p>` : ''}
          ${job.status === 'awaiting_confirmation' || job.status === 'uploaded' || job.status === 'failed'
            ? `<button type="button" data-edit-job="${escapeHtml(job.id)}">确认 / 重试</button>` : ''}
          ${job.result?.url ? `<a href="${escapeHtml(job.result.url)}">阅读 →</a>` : ''}
        </article>
      `).join('') : '<p class="hint">还没有书籍任务。</p>';
      jobsRoot.querySelectorAll<HTMLButtonElement>('[data-edit-job]').forEach((button) => button.addEventListener('click', () => {
        const job = jobs.find((item) => item.id === button.dataset.editJob);
        if (job) fillForm(job);
      }));
    } catch (error) {
      jobsRoot.innerHTML = `<p class="job-error">${escapeHtml(error instanceof Error ? error.message : '读取失败')}</p>`;
    }
  }
  document.querySelector('[data-refresh]')?.addEventListener('click', loadJobs);
  loadJobs();
</script>

<style>
  .admin-hero { padding: 4rem 0; color: white; background: #071723; }
  .admin-hero a { color: #8edbd7; }
  .admin-hero span { display: block; margin-top: 2rem; font: 600 .7rem/1 var(--font-mono); letter-spacing: .15em; color: #39c8c1; }
  .admin-hero h1 { margin: .8rem 0; font-size: clamp(2.2rem, 5vw, 4rem); }
  .admin-hero p { color: #c7d5db; }
  .admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-block: 2.5rem 5rem; }
  .panel { padding: 1.5rem; border: 1px solid var(--color-border); background: white; }
  .panel h2 { margin-top: 0; }
  .hint { color: var(--color-text-secondary); font-size: .86rem; }
  .drop { min-height: 180px; display: grid; place-content: center; gap: .5rem; padding: 1rem; border: 1px dashed #86a5ac; text-align: center; cursor: pointer; background: #f4f8f7; }
  .drop input { position: absolute; opacity: 0; pointer-events: none; }
  .drop span { color: var(--color-text-secondary); }
  .primary { width: 100%; margin-top: 1rem; padding: .85rem 1rem; border: 0; color: white; background: var(--color-accent); font-weight: 700; }
  .primary:disabled { opacity: .45; cursor: not-allowed; }
  .progress { margin-top: 1rem; }
  .confirm label { display: grid; gap: .4rem; margin-bottom: .85rem; color: var(--color-text-secondary); font-size: .78rem; }
  .confirm input, .confirm textarea, .confirm select { width: 100%; padding: .72rem; border: 1px solid var(--color-border); background: white; font: inherit; }
  .confirm .two { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .confirm .check { display: flex; grid-template-columns: auto 1fr; align-items: center; }
  .confirm .check input { width: auto; }
  .history { grid-column: 1 / -1; }
  .heading { display: flex; align-items: center; justify-content: space-between; }
  .job { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(220px, 1fr) auto auto; align-items: center; gap: .8rem; padding: .9rem 0; border-top: 1px solid var(--color-border); }
  .job small { display: block; margin-top: .25rem; font: .65rem/1 var(--font-mono); color: var(--color-text-secondary); }
  .job-stage { display: grid; gap: .3rem; font-size: .8rem; }
  .job-stage progress { width: 100%; accent-color: var(--color-accent); }
  .status { padding: .35rem .5rem; border-radius: 99px; background: #edf2f2; font: 600 .65rem/1 var(--font-mono); }
  .status-done { color: #087254; background: #dff6eb; }
  .status-failed, .job-error { color: #9b3e20; }
  .job-error { grid-column: 1 / -1; margin: 0; }
  @media (max-width: 820px) {
    .admin-grid { grid-template-columns: 1fr; }
    .history { grid-column: auto; }
    .job { grid-template-columns: 1fr; }
    .confirm .two { grid-template-columns: 1fr; }
  }
</style>
