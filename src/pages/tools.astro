---
// 工具脚本 — Python 教程 / APDL 教程 Tab 切换
import BaseLayout from '../layouts/BaseLayout.astro';
import CalcFEA from '../components/CalcFEA.astro';
import { getDomainKnowledgePoints, type LearningDomainSlug } from '../data/learning-catalog';
import { toolsChapterOrder, pythonKnowledgePoints, apdlKnowledgePoints, numpyKnowledgePoints, scipyKnowledgePoints } from '../data/tools-learning';

const domain: LearningDomainSlug = 'tools';
const points = getDomainKnowledgePoints(domain);
const chapterDescriptions: Record<string, string> = {
  'Python 入门': '认识 Python，配置环境，并完成从文件到终端输出的第一次运行。',
  '基础语法': '理解代码块、变量、命名、输入与输出，建立正确的代码阅读顺序。',
  '数据类型': '掌握数字、布尔值、字符串、类型转换和表达式的真实行为。',
  '流程控制': '使用条件和循环控制程序路径，明确边界与结束条件。',
  '数据结构': '用列表、元组、字典和集合组织不同关系的数据。',
  '函数与模块': '拆分职责、复用代码，并把程序组织为清晰的模块。',
  '文件与异常': '可靠读写文件，读懂错误并处理可预期失败。',
  '开发环境与规范': '管理解释器、安装工具和可复现的开发环境。',
  'APDL 与仿真基础': '认识 APDL 语言，了解 ANSYS 工作环境和三阶段工作流程。',
  '命令语法基础': '掌握命令格式、文件管理、日志复用与宏脚本。',
  '几何建模': '使用坐标系、关键点、线、面和体创建几何模型。',
  '网格划分': '定义单元类型、材料属性并生成有限元网格。',
  '加载与求解': '施加约束和载荷，选择求解器并执行求解。',
  '后处理': '查看云图、提取结果数据并绘制时间历程曲线。',
  '进阶操作': '使用选择、组件、参数化编程和流程控制实现自动分析。',
  '实战案例': '完成静力学和模态分析的完整 APDL 流程，并规划进阶学习路线。',
  'APDL 进阶': '整合专项分析技术与工具方法论，掌握工程判断与结果验证能力。',
  'NumPy 入门': '认识 NumPy，理解 ndarray 与列表的区别，掌握数组创建方法。',
  '索引与形状': '使用基础索引、花式索引和形状变换操作多维数组。',
  '运算与广播': '理解广播规则，使用通用函数实现高效向量化计算。',
  '数据与文件': '掌握线性代数、统计聚合、随机数和文件读写。',
  '工程应用': '使用插值、FFT 和数据处理模式解决仿真后处理问题。',
  'SciPy 入门': '了解 SciPy 生态，掌握插值和数据平滑方法。',
  '数值计算': '使用数值积分和优化算法求解工程问题。',
  '优化与线性代数': '使用 scipy.linalg 求解线性方程组和特征值问题。',
  '信号与图像': '使用信号处理工具和空间数据结构分析工程数据。',
  '统计分析': '使用概率分布和假设检验量化工程不确定性。',
  '进阶计算': '使用稀疏矩阵、ODE 求解器和 FFT 处理复杂计算问题。',
};
const allChapters = toolsChapterOrder.map((name) => ({
  name,
  description: chapterDescriptions[name] || '',
  points: points.filter((point) => point.group === name),
}));
const pythonChapters = allChapters.filter((c) => c.points.some((p) => p.series === 'python'));
const numpyChapters = allChapters.filter((c) => c.points.some((p) => p.series === 'numpy'));
const scipyChapters = allChapters.filter((c) => c.points.some((p) => p.series === 'scipy'));
const apdlChapters = allChapters.filter((c) => c.points.some((p) => p.series === 'apdl'));
const apdlPrimaryChapters = apdlChapters.filter((c) => c.name !== 'APDL 进阶');
const apdlAdvancedChapters = apdlChapters.filter((c) => c.name === 'APDL 进阶');
const apdlPrimaryCount = apdlPrimaryChapters.reduce((sum, c) => sum + c.points.filter(p => p.series === 'apdl').length, 0);
const apdlAdvancedCount = apdlAdvancedChapters.reduce((sum, c) => sum + c.points.filter(p => p.series === 'apdl').length, 0);
---

<BaseLayout title="工具脚本" description="面向仿真工程师的 Python 与 APDL 工程教程。" lang="zh" flush>
  <section class="tools-hero">
    <div class="container-wide">
      <div class="breadcrumbs"><a href="/">首页</a><span>/</span><strong>工具脚本</strong></div>
      <span class="tools-code" data-hero-label>PYTHON · NumPy · SciPy</span>
      <h1 data-hero-title>Python 工程教程</h1>
      <p data-hero-desc>从零开始学习 Python 编程、NumPy 数值计算和 SciPy 科学计算。教程均为预设原创内容，解释与代码紧密结合，不依赖 AI 生成。先建立扎实的工具基础，再逐步连接工程数据与仿真流程。</p>
      <div class="tools-actions">
        <button class="hero-tab active" data-tab-action="python">Python 教程</button>
        <button class="hero-tab" data-tab-action="apdl">APDL 教程</button>
      </div>
    </div>
  </section>

  <!-- ===== Python Tab ===== -->
  <div class="tab-panel active" data-tab-panel="python">
    <!-- Python 基础 section -->
    <section class="tools-learning">
      <div class="container-wide">
        <div class="section-heading">
          <div>
            <span>PYTHON FOUNDATION</span>
            <h2>Python 基础</h2>
          </div>
          <strong>{pythonKnowledgePoints.length} 篇</strong>
        </div>
        <p class="section-desc">从认识 Python 和配置环境开始，逐步掌握基础语法、数据类型、流程控制、数据结构、函数与模块、文件与异常处理。按知识主题组织，取消混杂的等级路线。</p>

        {
          pythonChapters.map((chapter, chapterIndex) => (
            <section class="chapter-section">
              <div class="chapter-heading">
                <span>{String(chapterIndex + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chapter.name}</h3>
                  <p>{chapter.description}</p>
                </div>
              </div>
              <div class="kp-grid">
                {chapter.points.filter((p) => p.series === 'python').map((point, pointIndex) => (
                  <a href={`/domains/tools/kp/${point.id}`} class="kp-card">
                    <span class="kp-index">{String(pointIndex + 1).padStart(2, '0')}</span>
                    <span class="kp-difficulty">{point.difficulty}</span>
                    <strong>{point.title}</strong>
                    <p>{point.description}</p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- NumPy section -->
    <section class="tools-learning">
      <div class="container-wide">
        <div class="section-heading">
          <div>
            <span>NUMPY NUMERICAL</span>
            <h2>NumPy 数值计算</h2>
          </div>
          <strong>{numpyKnowledgePoints.length} 篇</strong>
        </div>
        <p class="section-desc">构建在 Python 基础之上的数值计算教程。从数组创建和索引开始，逐步覆盖广播、线性代数、统计和 FFT，最终应用于工程数据处理场景。</p>

        {
          numpyChapters.map((chapter, chapterIndex) => (
            <section class="chapter-section">
              <div class="chapter-heading">
                <span>{String(chapterIndex + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chapter.name}</h3>
                  <p>{chapter.description}</p>
                </div>
              </div>
              <div class="kp-grid">
                {chapter.points.filter((p) => p.series === 'numpy').map((point, pointIndex) => (
                  <a href={`/domains/tools/kp/${point.id}`} class="kp-card">
                    <span class="kp-index">{String(pointIndex + 1).padStart(2, '0')}</span>
                    <span class="kp-difficulty">{point.difficulty}</span>
                    <strong>{point.title}</strong>
                    <p>{point.description}</p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- SciPy section -->
    <section class="tools-learning">
      <div class="container-wide">
        <div class="section-heading">
          <div>
            <span>SCIPY SCIENTIFIC</span>
            <h2>SciPy 科学计算</h2>
          </div>
          <strong>{scipyKnowledgePoints.length} 篇</strong>
        </div>
        <p class="section-desc">构建在 NumPy 之上的高级科学计算教程。覆盖插值、积分、优化、线性代数、信号处理和统计分析，结合结构工程场景讲解算法原理与应用。</p>

        {
          scipyChapters.map((chapter, chapterIndex) => (
            <section class="chapter-section">
              <div class="chapter-heading">
                <span>{String(chapterIndex + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chapter.name}</h3>
                  <p>{chapter.description}</p>
                </div>
              </div>
              <div class="kp-grid">
                {chapter.points.filter((p) => p.series === 'scipy').map((point, pointIndex) => (
                  <a href={`/domains/tools/kp/${point.id}`} class="kp-card">
                    <span class="kp-index">{String(pointIndex + 1).padStart(2, '0')}</span>
                    <span class="kp-difficulty">{point.difficulty}</span>
                    <strong>{point.title}</strong>
                    <p>{point.description}</p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- Python Tab 统一仿真实践占位 -->
    <section class="practice-section">
      <div class="container-wide practice-layout">
        <div>
          <span>SIMULATION PRACTICE</span>
          <h2>仿真实践</h2>
          <p>这里将放置与 Python / NumPy / SciPy 知识对应的真实仿真案例，包含输入、脚本、运行过程、结果和验证。案例需要经过筛选与复核后再发布。</p>
        </div>
        <div class="practice-placeholder">
          <strong>案例整理中</strong>
          <p>当前仅完成知识教程，暂不使用虚构案例填充。</p>
        </div>
      </div>
    </section>
  </div>

  <!-- ===== APDL Tab ===== -->
  <div class="tab-panel" data-tab-panel="apdl">
    <!-- APDL 初级 section -->
    <section class="tools-learning">
      <div class="container-wide">
        <div class="section-heading">
          <div>
            <span>APDL FOUNDATION</span>
            <h2>APDL 初级教程</h2>
          </div>
          <strong>{apdlPrimaryCount} 篇</strong>
        </div>
        <p class="section-desc">面向结构仿真工程师的 ANSYS APDL 命令流教程。从工作环境开始，逐步覆盖建模、网格、加载、求解和后处理的完整流程。建议从"认识 APDL"开始学习。</p>

        {
          apdlPrimaryChapters.map((chapter, chapterIndex) => (
            <section class="chapter-section">
              <div class="chapter-heading">
                <span>{String(chapterIndex + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chapter.name}</h3>
                  <p>{chapter.description}</p>
                </div>
              </div>
              <div class="kp-grid">
                {chapter.points.filter((p) => p.series === 'apdl').map((point, pointIndex) => (
                  <a href={`/domains/tools/kp/${point.id}`} class="kp-card">
                    <span class="kp-index">{String(pointIndex + 1).padStart(2, '0')}</span>
                    <span class="kp-difficulty">{point.difficulty}</span>
                    <strong>{point.title}</strong>
                    <p>{point.description}</p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- APDL 进阶专题 -->
    <section class="tools-learning">
      <div class="container-wide">
        <div class="section-heading">
          <div>
            <span>APDL ADVANCED TOPICS</span>
            <h2>APDL 进阶专题</h2>
          </div>
          <strong>{apdlAdvancedCount} 篇</strong>
        </div>
        <p class="section-desc">整合专项分析技术与工具方法论，掌握工程判断与结果验证能力。涵盖 APDL Math 矩阵运算、接触分析、屈曲分析、子模型技术和结果验证方法论。</p>

        {
          apdlAdvancedChapters.map((chapter, chapterIndex) => (
            <section class="chapter-section">
              <div class="chapter-heading">
                <span>{String(chapterIndex + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chapter.name}</h3>
                  <p>{chapter.description}</p>
                </div>
              </div>
              <div class="kp-grid">
                {chapter.points.filter((p) => p.series === 'apdl').map((point, pointIndex) => (
                  <a href={`/domains/tools/kp/${point.id}`} class="kp-card">
                    <span class="kp-index">{String(pointIndex + 1).padStart(2, '0')}</span>
                    <span class="kp-difficulty">{point.difficulty}</span>
                    <strong>{point.title}</strong>
                    <p>{point.description}</p>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- APDL Tab 统一仿真实践占位 -->
    <section class="practice-section">
      <div class="container-wide practice-layout">
        <div>
          <span>SIMULATION PRACTICE</span>
          <h2>仿真实践</h2>
          <p>这里将放置与 APDL 知识对应的真实仿真案例，包含输入、脚本、运行过程、结果和验证。案例需要经过筛选与复核后再发布。</p>
        </div>
        <div class="practice-placeholder">
          <strong>案例整理中</strong>
          <p>当前仅完成知识教程，暂不使用虚构案例填充。</p>
        </div>
      </div>
    </section>
  </div>

  <section class="container-wide existing-tool">
    <div class="section-heading">
      <div><span>UTILITY</span><h2>现有辅助工具</h2></div>
    </div>
    <CalcFEA lang="zh" />
  </section>

  <section class="container-wide tools-about">
    <h2>关于本模块</h2>
    <div class="about-grid">
      <div>
        <h3>正文原则</h3>
        <p>每篇教程均为预设原创内容，通过连续讲解、代码和运行结果说明概念。页面不调用 AI，也不以零散结论代替教程。</p>
      </div>
      <div>
        <h3>脚本仓库</h3>
        <p>独立脚本继续托管在 <a href="https://github.com/xiaoluobo1234/simulearn-scripts" target="_blank" rel="noopener">simulearn-scripts</a>，但不把脚本数量等同于教程质量。</p>
      </div>
      <div>
        <h3>内容状态</h3>
        <p>第一阶段完成 20 篇 Python 基础教程、25 篇 APDL 初级教程、15 篇 NumPy 数值计算教程和 15 篇 SciPy 科学计算教程。仿真实践及软件接口和自动化主题留待后续扩展。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Tab 切换与 hash 路由
  const heroButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab-action]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
  const heroLabel = document.querySelector<HTMLElement>('[data-hero-label]')!;
  const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]')!;
  const heroDesc = document.querySelector<HTMLElement>('[data-hero-desc]')!;

  const heroContent: Record<string, { label: string; title: string; desc: string }> = {
    python: {
      label: 'PYTHON · NumPy · SciPy',
      title: 'Python 工程教程',
      desc: '从零开始学习 Python 编程、NumPy 数值计算和 SciPy 科学计算。教程均为预设原创内容，解释与代码紧密结合，不依赖 AI 生成。先建立扎实的工具基础，再逐步连接工程数据与仿真流程。',
    },
    apdl: {
      label: 'APDL · ANSYS MAPDL',
      title: 'APDL 仿真命令流教程',
      desc: '面向结构仿真工程师的 ANSYS APDL 命令流教程。从工作环境到完整分析流程，逐步覆盖建模、网格、加载、求解和后处理。用文本命令替代 GUI 点击，实现可追溯、可复用的参数化分析。',
    },
  };

  function activateTab(tab: string, pushState = true) {
    heroButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.tabAction === tab));
    panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.tabPanel === tab));
    const hc = heroContent[tab] || heroContent.python;
    heroLabel.textContent = hc.label;
    heroTitle.textContent = hc.title;
    heroDesc.textContent = hc.desc;
    if (pushState && location.hash !== `#${tab}`) {
      history.pushState(null, '', `#${tab}`);
    }
  }

  heroButtons.forEach((btn) => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tabAction!));
  });

  // 初始化：读取 hash
  const initialTab = location.hash === '#apdl' ? 'apdl' : 'python';
  activateTab(initialTab, false);

  // 浏览器前进/后退
  window.addEventListener('hashchange', () => {
    const tab = location.hash === '#apdl' ? 'apdl' : 'python';
    activateTab(tab, false);
  });
</script>

<style>
  .tools-hero { padding: 4.5rem 0 3rem; color: white; background: linear-gradient(135deg, #1a3a4a 0%, #0d2b3a 50%, #1a2f3a 100%); }
  .tools-hero .breadcrumbs { margin-bottom: 1rem; }
  .tools-hero .breadcrumbs a { color: var(--color-accent-light); }
  .tools-hero .breadcrumbs span, .tools-hero .breadcrumbs strong { color: #bdd0d7; }
  .tools-code { display: block; font: 600 .7rem/1 var(--font-mono); letter-spacing: .14em; color: var(--color-accent-light); margin-bottom: 1rem; }
  .tools-hero h1 { margin: .5rem 0 1rem; color: white; font-size: clamp(2.3rem, 5vw, 4rem); }
  .tools-hero p { max-width: 720px; color: #bdd0d7; font-size: 1.05rem; line-height: 1.7; }
  .tools-actions { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero-tab { padding: .9rem 1.8rem; border: none; font-weight: 700; font-size: 0.92rem; cursor: pointer; border-radius: 4px; color: #8b9a9f; background: rgba(255,255,255,0.10); transition: background .15s, color .15s; }
  .hero-tab:hover { background: rgba(255,255,255,0.16); color: #bdd0d7; }
  .hero-tab.active { color: white; }
  .hero-tab[data-tab-action="python"].active { background: var(--color-accent); }
  .hero-tab[data-tab-action="apdl"].active { background: #2a5f7a; }

  /* Tab 面板 */
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  .tools-learning { padding: 4rem 0 2rem; }
  .tools-learning h2 { font-size: 1.8rem; margin: .25rem 0 0; }
  .section-desc { color: var(--color-text-secondary); max-width: 720px; margin-bottom: 2rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading span { color: var(--color-accent); font: 650 .65rem/1 var(--font-mono); letter-spacing: .12em; }
  .section-heading strong { color: #8b9a9f; font: 600 .75rem/1 var(--font-mono); }
  .chapter-section { padding: 2rem 0 2.5rem; border-top: 1px solid var(--color-border); }
  .chapter-heading { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: .8rem; margin-bottom: 1.2rem; }
  .chapter-heading > span { color: #9dabad; font: 600 .68rem/1.5 var(--font-mono); }
  .chapter-heading h3 { margin: 0 0 .25rem; color: var(--color-primary); font-size: 1.2rem; }
  .chapter-heading p { max-width: 680px; margin: 0; color: var(--color-text-secondary); font-size: .84rem; line-height: 1.55; }

  .kp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; }
  .kp-card { position: relative; display: block; min-height: 142px; padding: 1rem; border: 1px solid var(--color-border); background: white; text-decoration: none; color: var(--color-text); transition: box-shadow .15s, border-color .15s, transform .15s; }
  .kp-card:hover { box-shadow: var(--shadow-sm); border-color: var(--color-accent); transform: translateY(-2px); }
  .kp-index { color: #a8b3b5; font: 600 .62rem/1 var(--font-mono); }
  .kp-difficulty { float: right; padding: .22rem .45rem; color: #527078; background: #edf4f2; border-radius: 2px; font: 600 .58rem/1 var(--font-mono); }
  .kp-card strong { display: block; font-size: .92rem; margin-bottom: .3rem; color: var(--color-primary); }
  .kp-card strong { margin-top: 1.2rem; }
  .kp-card p { font-size: .78rem; line-height: 1.55; color: var(--color-text-secondary); margin: 0; }

  /* APDL 进阶占位 */
  .apdl-advanced-placeholder { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; margin-top: 1.5rem; }
  .placeholder-card { min-height: 160px; padding: 1.2rem; border: 1px dashed #b0c4c0; background: #f9fbfa; text-align: center; display: flex; flex-direction: column; justify-content: center; gap: .5rem; }
  .placeholder-card strong { color: var(--color-primary); font-size: .95rem; }
  .placeholder-card p { color: var(--color-text-secondary); font-size: .78rem; line-height: 1.5; margin: 0; }
