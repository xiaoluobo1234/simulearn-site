---
import BaseLayout from '../layouts/BaseLayout.astro';
import { domains } from '../data/domains';
import { roadmapPhases } from '../data/roadmap';
---

<BaseLayout title="十年学习路线" description="SimuLearn 2026—2036 芯片多物理场仿真学习路线与公开进度。" lang="zh" flush>
  <section class="page-hero roadmap-hero">
    <div class="container-wide">
      <span class="eyebrow">Public roadmap · 2026—2036</span>
      <h1>十年路线不是预测，<br />是一份持续校准的工程计划</h1>
      <p>从结构有限元出发，依次补齐热、流体和多物理场能力，先进入芯片封装与电子散热，再谨慎延伸到器件和工艺 TCAD。</p>
      <div class="roadmap-rules">
        <span>每季度复盘</span><span>完成以案例为证</span><span>允许路线调整</span>
      </div>
    </div>
  </section>

  <section class="status-strip">
    <div class="container-wide status-grid">
      {domains.map((domain) => (
        <a href={`/domains/${domain.slug}`} style={`--accent:${domain.accent}`}>
          <div><small>{domain.code}</small><strong>{domain.label}</strong></div>
          <span>{domain.progress}%</span>
          <i><b style={`width:${domain.progress}%`}></b></i>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section">
    <div class="container-wide">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Five phases</span>
          <h2>路线分成五个可检查阶段</h2>
        </div>
        <p>“完成”不等于看完课程。每个阶段至少要产生一个可复算案例、一套验证清单和一项可复用工具。</p>
      </div>

      <div class="timeline">
        {roadmapPhases.map((phase, index) => (
          <article class:list={['phase', { active: index === 0 }]}>
            <div class="phase-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
            <div class="phase-content">
              <div class="phase-meta">
                <span>{phase.years}</span>
                <span class:list={['status', index === 0 ? 'status--active' : 'status--planned']}>{phase.status}</span>
              </div>
              <h3>{phase.title}</h3>
              <p>{phase.description}</p>
              <div class="milestones">
                {phase.milestones.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="evidence-section content-section">
    <div class="container-wide evidence-layout">
      <div>
        <span class="eyebrow">Definition of done</span>
        <h2>用证据定义进度</h2>
        <p>公开进度只记录已经发生的学习与实践，不用“了解”“掌握”等模糊词代替证据。</p>
      </div>
      <div class="evidence-grid">
        <div><span>01</span><strong>理论证据</strong><p>能说明控制方程、假设和适用边界。</p></div>
        <div><span>02</span><strong>模型证据</strong><p>有可追溯输入、基准和网格策略。</p></div>
        <div><span>03</span><strong>验证证据</strong><p>完成守恒、收敛和敏感性检查。</p></div>
        <div><span>04</span><strong>复用证据</strong><p>沉淀案例模板、脚本或诊断卡片。</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap-hero { padding-block: 5.5rem; }
  .roadmap-hero h1 { max-width: 880px; }
  .roadmap-hero p { font-size: 1.02rem; }
  .roadmap-rules { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2.2rem; }
  .roadmap-rules span { padding: 0.42rem 0.68rem; border: 1px solid rgba(255,255,255,0.16); color: #9eb4b6; font: 500 0.66rem/1 var(--font-mono); }

  .status-strip { background: white; border-bottom: 1px solid var(--color-border); }
  .status-grid { min-height: 120px; display: grid; grid-template-columns: repeat(5, 1fr); }
  .status-grid a { padding: 1.5rem 1.2rem; color: var(--color-text); border-right: 1px solid var(--color-border-light); }
  .status-grid a:first-child { border-left: 1px solid var(--color-border-light); }
  .status-grid a:hover { background: #f8fbfa; color: var(--color-text); }
  .status-grid div { display: flex; align-items: baseline; gap: 0.6rem; }
  .status-grid small { color: var(--accent); font: 600 0.62rem/1 var(--font-mono); }
  .status-grid strong { font-size: 0.84rem; }
  .status-grid > a > span { display: block; margin-top: 0.8rem; color: #819198; font: 500 0.65rem/1 var(--font-mono); }
  .status-grid i { display: block; height: 2px; margin-top: 0.6rem; background: var(--color-code-bg); }
  .status-grid b { display: block; height: 100%; background: var(--accent); }

  .timeline { position: relative; margin-top: 1rem; }
  .timeline::before { content: ''; position: absolute; top: 0; bottom: 0; left: 42px; width: 1px; background: var(--color-border); }
  .phase { position: relative; display: grid; grid-template-columns: 84px 1fr; gap: 2rem; padding-bottom: 2.2rem; }
  .phase-marker { position: relative; z-index: 1; width: 84px; display: grid; justify-items: center; }
  .phase-marker span { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: #7e9096; background: var(--color-bg); border: 1px solid var(--color-border); font: 500 0.68rem/1 var(--font-mono); }
  .phase.active .phase-marker span { color: white; background: var(--color-accent); border-color: var(--color-accent); box-shadow: 0 0 0 7px rgba(12,143,135,0.1); }
  .phase-content { padding: 1.8rem 2rem; background: white; border: 1px solid var(--color-border); border-radius: 10px; }
  .phase.active .phase-content { border-top: 3px solid var(--color-accent); box-shadow: var(--shadow-md); }
  .phase-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--color-accent); font: 600 0.7rem/1 var(--font-mono); }
  .phase-content h3 { margin: 1.1rem 0 0.7rem; font-size: 1.4rem; }
  .phase-content > p { color: var(--color-text-secondary); font-size: 0.87rem; }
  .milestones { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .milestones span { padding: 0.48rem 0.7rem; background: var(--color-code-bg); border-radius: 3px; color: #526870; font-size: 0.72rem; }

  .evidence-section { background: #dfe8e6; }
  .evidence-layout { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 4rem; align-items: start; }
  .evidence-layout h2 { border: 0; padding: 0; margin: 0.8rem 0; }
  .evidence-layout > div:first-child p { color: var(--color-text-secondary); }
  .evidence-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; border: 1px solid #cbd8d6; background: #cbd8d6; }
  .evidence-grid div { min-height: 170px; padding: 1.5rem; background: white; display: grid; align-content: start; }
  .evidence-grid span { color: var(--color-accent); font: 600 0.65rem/1 var(--font-mono); }
  .evidence-grid strong { margin-top: 1rem; }
  .evidence-grid p { margin: 0.5rem 0 0; color: var(--color-text-secondary); font-size: 0.76rem; }

  @media (max-width: 780px) {
    .status-grid { grid-template-columns: repeat(2, 1fr); }
    .status-grid a { border-bottom: 1px solid var(--color-border-light); }
    .evidence-layout { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 520px) {
    .roadmap-hero { padding-block: 4rem; }
    .status-grid { grid-template-columns: 1fr; }
    .status-grid a { padding: 1rem; }
    .phase { grid-template-columns: 48px 1fr; gap: 0.7rem; }
    .timeline::before { left: 24px; }
    .phase-marker { width: 48px; }
    .phase-marker span { width: 38px; height: 38px; }
    .phase-content { padding: 1.3rem; }
    .evidence-grid { grid-template-columns: 1fr; }
  }
</style>
