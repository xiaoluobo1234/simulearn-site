---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { domains, type Domain } from '../../data/domains';
import {
  structuralLevelLabels,
  structuralPlans,
  type StructuralLearningLevel,
} from '../../data/structural-learning';

export function getStaticPaths() {
  return domains.map((domain) => ({
    params: { slug: domain.slug },
    props: { domain },
  }));
}

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const currentIndex = domains.findIndex((item) => item.slug === domain.slug);
const nextDomain = domains[currentIndex + 1] ?? domains[0];
const domainTitle = domain.slug === 'chip' ? '芯片仿真' : `${domain.label}仿真`;
const nextDomainTitle = nextDomain.slug === 'chip' ? '芯片仿真' : `${nextDomain.label}仿真`;
const isStructural = domain.slug === 'structural';
const displayedSections = isStructural
  ? [domain.sections[0], ...domain.sections.slice(2)]
  : domain.sections;
const structuralLevels = Object.keys(structuralPlans) as StructuralLearningLevel[];
---

<BaseLayout title={domainTitle} description={domain.summary} lang="zh" flush>
  <section class="domain-hero" style={`--domain-accent:${domain.accent}`}>
    <div class="container-wide">
      <div class="breadcrumbs"><a href="/">首页</a><span>/</span><span>领域</span><span>/</span><strong>{domain.label}</strong></div>
      <div class="hero-grid">
        <div>
          <span class="domain-code">{domain.code} / {domain.englishLabel.toUpperCase()}</span>
          <h1>{domainTitle}</h1>
          <p>{domain.summary}</p>
          <div class="tool-list">
            {domain.tools.map((tool) => <span>{tool}</span>)}
          </div>
        </div>
        <div class="progress-module">
          <div class="progress-top">
            <span>LEARNING PROGRESS</span>
            <strong>{domain.progress}<small>%</small></strong>
          </div>
          <div class="progress-line"><span style={`width:${domain.progress}%`}></span></div>
          <span class:list={['status', domain.status === '路线规划' ? 'status--planned' : 'status--active']}>{domain.status}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="domain-question">
    <div class="container-wide question-grid">
      <span>CORE QUESTION</span>
      <blockquote>{domain.question}</blockquote>
      <div>
        <small>能力目标</small>
        <p>{domain.target}</p>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container-wide content-layout">
      <aside class="section-index">
        <span>内容索引</span>
        <nav>
          {displayedSections.map((item, index) => (
            <a href={`#${item.id}`}><small>{String(index + 1).padStart(2, '0')}</small>{isStructural && index === 0 ? '学习路线与知识点' : item.title}</a>
          ))}
        </nav>
      </aside>

      <div
        class="section-list"
        data-domain-slug={domain.slug}
        data-domain-accent={domain.accent}
        data-preset-structural={isStructural ? 'true' : undefined}
      >
        {/* 01 学习路线 — interactive */}
        <article id={domain.sections[0].id} class="knowledge-section learning-path-section">
          <div class="section-number">01</div>
          <div>
            <div class="section-title-row">
              <h2>{isStructural ? '学习路线与知识点' : domain.sections[0].title}</h2>
              <span data-plan-badge>{isStructural ? '初级 · 0/20 通过' : '待生成'}</span>
            </div>
            <p>{isStructural ? '固定三级技术路线，选择等级即可进入预设知识点；AI 仅在需要拓展、问答或评判时调用。' : domain.sections[0].description}</p>
            <div class="level-tabs" data-level-tabs>
              <button type="button" class="level-tab active" data-level="low">初级</button>
              <button type="button" class="level-tab" data-level="mid">中级</button>
              <button type="button" class="level-tab" data-level="high">高级</button>
            </div>
            <div class="plan-area" data-plan-area>
              {isStructural ? (
                structuralLevels.map((level) => (
                  <div class="preset-plan-panel" data-plan-panel={level} hidden={level !== 'low'}>
                    <div class="preset-plan-meta">
                      <strong>{structuralLevelLabels[level]}</strong>
                      <span>{structuralPlans[level].length} 个知识点 · 可按任意顺序学习</span>
                    </div>
                    <div class="preset-plan-nodes">
                      {structuralPlans[level].map((node, index) => (
                        <a
                          href={`/domains/structural/kp/${node.id}`}
                          class="preset-plan-node pending"
                          data-node-id={node.id}
                        >
                          <span class="node-order">{String(index + 1).padStart(2, '0')}</span>
                          <span class="node-status">待学习</span>
                          <small>{node.group}</small>
                          <h3>{node.title}</h3>
                          <p>{node.description}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                ))
              ) : (
                <button type="button" class="generate-btn" data-generate-btn>生成学习计划</button>
              )}
            </div>
          </div>
        </article>

        {/* 02 知识点 — interactive */}
        {!isStructural && (
          <article id={domain.sections[1].id} class="knowledge-section kp-section">
            <div class="section-number">02</div>
            <div>
              <div class="section-title-row">
                <h2>{domain.sections[1].title}</h2>
                <span data-kp-badge>待生成</span>
              </div>
              <p>{domain.sections[1].description}</p>
              <div class="kp-grid" data-kp-grid>
                <p class="plan-hint">请先在上方「学习路线」生成学习计划。</p>
              </div>
            </div>
          </article>
        )}

        {/* 03–07 静态部分 */}
        {domain.sections.slice(2).map((item, idx) => (
          <article id={item.id} class="knowledge-section">
            <div class="section-number">{String(idx + (isStructural ? 2 : 3)).padStart(2, '0')}</div>
            <div>
              <div class="section-title-row">
                <h2>{item.title}</h2>
                <span>{domain.status === '路线规划' ? '规划中' : '持续更新'}</span>
              </div>
              <p>{item.description}</p>
              <ul>
                {item.items.map((entry) => (
                  <li>
                    <span class="item-marker"></span>
                    <span>{entry}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="next-section">
    <div class="container-wide next-layout">
      <div>
        <span class="eyebrow">Cross-domain path</span>
        <h2>单场可信，耦合才有意义</h2>
        <p>每个领域都不是孤岛。页面保留统一结构，便于比较不同物理场的建模假设、验证证据和工具链。</p>
      </div>
      <a href={`/domains/${nextDomain.slug}`} class="next-card" style={`--next-accent:${nextDomain.accent}`}>
        <small>NEXT FIELD · {nextDomain.code}</small>
        <strong>{nextDomainTitle}</strong>
        <span>{nextDomain.summary}</span>
        <b>继续 →</b>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .domain-hero {
    position: relative;
    overflow: hidden;
    padding: 2rem 0 4.5rem;
    color: #b5c6c8;
    background:
      radial-gradient(circle at 82% 40%, color-mix(in srgb, var(--domain-accent) 17%, transparent), transparent 30%),
      var(--color-primary-deep);
  }

  .domain-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(90deg, transparent, black);
  }

  .domain-hero .container-wide { position: relative; z-index: 1; }
  .breadcrumbs { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 4rem; font: 500 0.65rem/1 var(--font-mono); color: #627e84; }
  .breadcrumbs a { color: #8ea6a8; }
  .breadcrumbs strong { color: var(--domain-accent); }
  .hero-grid { display: grid; grid-template-columns: 1fr 310px; gap: 5rem; align-items: end; }
  .domain-code { color: var(--domain-accent); font: 600 0.7rem/1 var(--font-mono); letter-spacing: 0.13em; }
  .domain-hero h1 { margin: 0.8rem 0 1rem; color: white; font-size: clamp(3.2rem, 7vw, 5.5rem); }
  .domain-hero p { max-width: 680px; font-size: 1rem; }
  .tool-list { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 2rem; }
  .tool-list span { padding: 0.4rem 0.65rem; border: 1px solid rgba(255,255,255,0.12); border-radius: 3px; color: #9ab0b2; font: 500 0.65rem/1 var(--font-mono); }
  .progress-module { padding: 1.4rem; border: 1px solid rgba(255,255,255,0.12); background: rgba(11,34,48,0.64); }
  .progress-top { display: flex; justify-content: space-between; align-items: start; color: #799396; font: 500 0.6rem/1.4 var(--font-mono); letter-spacing: 0.08em; }
  .progress-top strong { color: white; font-size: 2.6rem; line-height: 0.8; }
  .progress-top small { color: var(--domain-accent); font-size: 0.75rem; }
  .progress-line { height: 3px; margin: 1.4rem 0 1rem; background: rgba(255,255,255,0.1); }
  .progress-line span { display: block; height: 100%; background: var(--domain-accent); }
  .progress-module .status { color: #96aeb0; }

  .domain-question { background: white; border-bottom: 1px solid var(--color-border); }
  .question-grid { min-height: 150px; display: grid; grid-template-columns: 130px 1.3fr 0.7fr; gap: 2rem; align-items: center; }
  .question-grid > span { color: var(--color-accent); font: 600 0.62rem/1.4 var(--font-mono); letter-spacing: 0.11em; }
  .question-grid blockquote { margin: 0; padding: 0 2rem; background: none; border-left-color: var(--domain-accent); border-radius: 0; color: var(--color-primary); font: 650 1.25rem/1.5 var(--font-heading); }
  .question-grid small { color: #8a999f; font: 600 0.65rem/1 var(--font-mono); }
  .question-grid p { margin: 0.45rem 0 0; color: var(--color-text-secondary); font-size: 0.78rem; line-height: 1.6; }

  .content-layout { display: grid; grid-template-columns: 190px 1fr; gap: 4rem; align-items: start; }
  .section-index { position: sticky; top: 100px; }
  .section-index > span { color: #8a999f; font: 600 0.65rem/1 var(--font-mono); letter-spacing: 0.1em; }
  .section-index nav { display: grid; margin-top: 1rem; border-top: 1px solid var(--color-border); }
  .section-index a { display: flex; gap: 0.8rem; padding: 0.7rem 0; border-bottom: 1px solid var(--color-border-light); color: var(--color-text-secondary); font-size: 0.8rem; }
  .section-index a:hover { color: var(--color-accent); }
  .section-index small { color: #a2b0b4; font-family: var(--font-mono); }
  .section-list { border-top: 1px solid var(--color-border); }
  .knowledge-section { display: grid; grid-template-columns: 58px 1fr; gap: 1.5rem; padding: 2.6rem 0; border-bottom: 1px solid var(--color-border); scroll-margin-top: 100px; }
  .section-number { padding-top: 0.3rem; color: var(--color-accent); font: 550 0.72rem/1 var(--font-mono); }
  .section-title-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .section-title-row h2 { margin: 0; padding: 0; border: 0; font-size: 1.5rem; }
  .section-title-row > span { padding: 0.35rem 0.55rem; color: #788b91; border: 1px solid var(--color-border); border-radius: 100px; font: 500 0.62rem/1 var(--font-mono); }
  .knowledge-section p { margin: 0.8rem 0 1.2rem; color: var(--color-text-secondary); font-size: 0.86rem; }
  .knowledge-section ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; list-style: none; padding: 0; margin: 0; }
  .knowledge-section li { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 0.8rem; border: 1px solid var(--color-border-light); background: rgba(255,255,255,0.65); font-size: 0.78rem; }
  .item-marker { width: 5px; height: 5px; flex: 0 0 auto; background: var(--domain-accent); transform: rotate(45deg); }

  /* ── Learning path interactive ── */
  .level-tabs { display: flex; gap: 0; margin: 1.5rem 0 1rem; border: 1px solid var(--color-border); border-radius: 4px; overflow: hidden; width: fit-content; }
  .level-tab { padding: 0.55rem 1.4rem; border: none; background: none; color: var(--color-text-secondary); font: 500 0.78rem/1 var(--font-mono); cursor: pointer; transition: all 0.15s; border-right: 1px solid var(--color-border); }
  .level-tab:last-child { border-right: none; }
  .level-tab.active { background: var(--domain-accent); color: white; }
  .level-tab:hover:not(.active) { background: rgba(0,0,0,0.04); }
  .generate-btn { padding: 0.7rem 1.6rem; border: none; background: var(--domain-accent); color: white; border-radius: 4px; font: 600 0.82rem/1 var(--font-heading); cursor: pointer; transition: opacity 0.15s; }
  .generate-btn:hover { opacity: 0.88; }
  .plan-area { margin-top: 0.5rem; }
  .plan-area .loading, .plan-area .error { padding: 1rem 0; font-size: 0.82rem; color: var(--color-text-secondary); }
  .plan-area .error { color: #d05050; }
  .preset-plan-meta { display: flex; align-items: baseline; gap: 0.8rem; margin: 0.4rem 0 0.85rem; }
  .preset-plan-meta strong { color: var(--color-primary); font-size: 0.82rem; }
  .preset-plan-meta span { color: #8a999f; font: 500 0.65rem/1 var(--font-mono); }
  .preset-plan-nodes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.65rem; }
  .preset-plan-node {
    position: relative;
    display: block;
    min-height: 138px;
    padding: 0.85rem;
    color: inherit;
    border: 1px solid var(--color-border-light);
    border-radius: 4px;
    background: rgba(255,255,255,0.72);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .preset-plan-node:hover { color: inherit; border-color: var(--domain-accent); box-shadow: 0 3px 10px rgba(0,0,0,0.07); transform: translateY(-1px); }
  .preset-plan-node.passed { border-color: #5cb8a6; background: rgba(92,184,166,0.06); }
  .preset-plan-node.studying { border-color: #f0a050; background: rgba(240,160,80,0.06); }
  .preset-plan-node .node-order { color: var(--domain-accent); font: 600 0.62rem/1 var(--font-mono); }
  .preset-plan-node .node-status {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    padding: 0.2rem 0.38rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: #788b91;
    font: 500 0.55rem/1 var(--font-mono);
  }
  .preset-plan-node.passed .node-status { color: #2d8a76; border-color: #5cb8a6; }
  .preset-plan-node.studying .node-status { color: #c07020; border-color: #f0a050; }
  .preset-plan-node small { display: block; margin: 0.8rem 0 0.32rem; padding-right: 2.7rem; color: #8a999f; font: 500 0.58rem/1.2 var(--font-mono); }
  .preset-plan-node h3 { margin: 0 0 0.35rem; color: var(--color-primary); font-size: 0.86rem; line-height: 1.35; }
  .preset-plan-node p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .plan-nodes { display: grid; gap: 0.8rem; margin-top: 0.5rem; }
  .plan-node { display: grid; grid-template-columns: 80px 1fr; gap: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--color-border-light); border-radius: 4px; background: rgba(255,255,255,0.65); transition: box-shadow 0.15s; }
  .plan-node:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .plan-node.passed { border-color: #5cb8a6; background: rgba(92,184,166,0.06); }
  .plan-node.studying { border-color: #f0a050; background: rgba(240,160,80,0.06); }
  .node-status { display: flex; align-items: center; justify-content: center; padding: 0.35rem 0.5rem; border: 1px solid var(--color-border); border-radius: 100px; font: 500 0.62rem/1 var(--font-mono); color: #788b91; height: fit-content; align-self: start; margin-top: 0.2rem; }
  .plan-node.passed .node-status { color: #2d8a76; border-color: #5cb8a6; background: rgba(92,184,166,0.1); }
  .plan-node.studying .node-status { color: #c07020; border-color: #f0a050; background: rgba(240,160,80,0.1); }
  .plan-node h3 { margin: 0 0 0.3rem; font-size: 0.92rem; font-weight: 600; color: var(--color-primary); }
  .plan-node p { margin: 0 0 0.4rem; font-size: 0.78rem; color: var(--color-text-secondary); line-height: 1.5; }
  .plan-node .prereq { font-size: 0.7rem; color: #9aa8ac; font-family: var(--font-mono); }
  .node-actions { margin-top: 0.5rem; }
  .node-link { font-size: 0.75rem; font-weight: 600; color: var(--domain-accent); }
  .node-link:hover { opacity: 0.8; }
  .kp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.8rem; margin-top: 1rem; }
  .kp-card { display: block; padding: 1rem 1.2rem; border: 1px solid var(--color-border-light); border-radius: 4px; background: rgba(255,255,255,0.65); text-decoration: none; transition: all 0.15s; position: relative; }
  .kp-card:hover { border-color: var(--domain-accent); box-shadow: 0 2px 8px rgba(0,0,0,0.06); transform: translateY(-1px); }
  .kp-card.passed { border-color: #5cb8a6; }
  .kp-card.studying { border-color: #f0a050; }
  .kp-card-status { position: absolute; top: 0.6rem; right: 0.8rem; padding: 0.2rem 0.4rem; border: 1px solid var(--color-border); border-radius: 100px; font: 500 0.58rem/1 var(--font-mono); color: #788b91; }
  .kp-card.passed .kp-card-status { color: #2d8a76; border-color: #5cb8a6; }
  .kp-card.studying .kp-card-status { color: #c07020; border-color: #f0a050; }
  .kp-card h3 { margin: 0 0 0.3rem; padding-right: 3rem; font-size: 0.88rem; font-weight: 600; color: var(--color-primary); }
  .kp-card p { margin: 0; font-size: 0.75rem; color: var(--color-text-secondary); line-height: 1.4; }
  .plan-hint { grid-column: 1/-1; padding: 1.5rem 0; text-align: center; font-size: 0.8rem; color: #9aa8ac; }

  .next-section { padding: 4.5rem 0; background: #dfe8e6; }
  .next-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: center; }
  .next-layout h2 { border: 0; padding: 0; margin: 0.8rem 0; }
  .next-layout > div p { max-width: 520px; margin: 0; color: var(--color-text-secondary); }
  .next-card { padding: 2rem; position: relative; display: grid; color: #b7c7c8; background: var(--color-primary-deep); border-top: 3px solid var(--next-accent); }
  .next-card:hover { color: #b7c7c8; transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .next-card small { color: var(--next-accent); font: 500 0.62rem/1 var(--font-mono); letter-spacing: 0.1em; }
  .next-card strong { margin-top: 1rem; color: white; font-size: 1.4rem; }
  .next-card span { margin-top: 0.5rem; font-size: 0.78rem; max-width: 500px; }
  .next-card b { position: absolute; right: 1.6rem; top: 1.6rem; color: white; font-size: 0.75rem; }

  @media (max-width: 800px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .breadcrumbs { margin-bottom: 3rem; }
    .question-grid { grid-template-columns: 1fr; gap: 1rem; padding-block: 2rem; }
    .question-grid blockquote { padding-left: 1.2rem; }
    .content-layout { grid-template-columns: 1fr; gap: 1.5rem; }
    .section-index { position: static; }
    .section-index nav { grid-template-columns: repeat(4, 1fr); }
    .section-index a { display: grid; gap: 0.2rem; }
    .next-layout { grid-template-columns: 1fr; gap: 2rem; }
    .plan-node { grid-template-columns: 1fr; gap: 0.6rem; }
    .node-status { justify-self: start; }
    .preset-plan-nodes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kp-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 520px) {
    .domain-hero { padding-bottom: 3rem; }
    .section-index nav { grid-template-columns: repeat(2, 1fr); }
    .knowledge-section { grid-template-columns: 34px 1fr; gap: 0.6rem; padding: 2rem 0; }
    .knowledge-section ul { grid-template-columns: 1fr; }
    .section-title-row { align-items: start; }
    .section-title-row > span { display: none; }
    .kp-grid { grid-template-columns: 1fr; }
    .preset-plan-nodes { grid-template-columns: 1fr; }
    .preset-plan-meta { align-items: flex-start; flex-direction: column; gap: 0.3rem; }
    .level-tabs { width: 100%; }
    .level-tab { flex: 1; text-align: center; }
  }
</style>

<script is:inline>
  (function () {
    var sectionList = document.querySelector('[data-domain-slug]');
    if (!sectionList) return;

    var domain = sectionList.getAttribute('data-domain-slug');
    var currentLevel = 'low';
    var progress = null;

    var levelLabels = { low: '初级', mid: '中级', high: '高级' };
    var statusLabels = { pending: '待学习', studying: '学习中', passed: '已通过' };

    var levelTabs = sectionList.querySelectorAll('[data-level]');
    var planArea = sectionList.querySelector('[data-plan-area]');
    var planBadge = sectionList.querySelector('[data-plan-badge]');
    var kpGrid = sectionList.querySelector('[data-kp-grid]');
    var kpBadge = sectionList.querySelector('[data-kp-badge]');

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c];
      });
    }

    function api(url, options) {
      options = options || {};
      options.credentials = 'same-origin';
      if (options.body) {
        options.headers = options.headers || {};
        options.headers['Content-Type'] = options.headers['Content-Type'] || 'application/json';
      }
      return fetch(url, options).then(function (r) { return r.json(); });
    }

    if (sectionList.getAttribute('data-preset-structural') === 'true') {
      var presetPanels = sectionList.querySelectorAll('[data-plan-panel]');

      function renderPresetLevel(level) {
        currentLevel = level;
        levelTabs.forEach(function (tab) {
          tab.classList.toggle('active', tab.getAttribute('data-level') === level);
        });
        presetPanels.forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-plan-panel') !== level;
        });

        var activePanel = sectionList.querySelector('[data-plan-panel="' + level + '"]');
        var cards = activePanel ? activePanel.querySelectorAll('[data-node-id]') : [];
        var passedCount = 0;
        cards.forEach(function (card) {
          if (card.classList.contains('passed')) passedCount++;
        });
        planBadge.textContent = levelLabels[level] + ' · ' + passedCount + '/' + cards.length + ' 通过';
      }

      function applyPresetProgress(nodes) {
        sectionList.querySelectorAll('[data-node-id]').forEach(function (card) {
          var nodeId = card.getAttribute('data-node-id');
          var nodeProgress = nodes && nodes[nodeId] ? nodes[nodeId] : { status: 'pending' };
          var status = nodeProgress.status || 'pending';
          card.classList.remove('pending', 'studying', 'passed');
          card.classList.add(status);
          var statusEl = card.querySelector('.node-status');
          if (statusEl) statusEl.textContent = statusLabels[status] || '待学习';
        });
        renderPresetLevel(currentLevel);
      }

      levelTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          renderPresetLevel(tab.getAttribute('data-level') || 'low');
        });
      });

      renderPresetLevel('low');
      api('/api/learning/progress?domain=' + encodeURIComponent(domain))
        .then(function (data) {
          if (data.ok && data.progress) {
            progress = data.progress;
            applyPresetProgress(progress.nodes || {});
          }
        })
        .catch(function () {
          // Preset content remains fully usable when progress storage is unavailable.
        });
      return;
    }

    function loadProgress() {
      planArea.innerHTML = '<p class="loading">正在加载学习进度……</p>';
      api('/api/learning/progress?domain=' + encodeURIComponent(domain))
        .then(function (data) {
          if (data.ok && data.progress && data.progress.plan) {
            progress = data.progress;
            currentLevel = progress.level || 'low';
            syncTabs();
            renderPlan();
          } else {
            progress = null;
            showGenerateButton();
          }
        })
        .catch(function () { showGenerateButton(); });
    }

    function syncTabs() {
      levelTabs.forEach(function (tab) {
        tab.classList.toggle('active', tab.getAttribute('data-level') === currentLevel);
      });
    }

    function generatePlan() {
      planArea.innerHTML = '<p class="loading">AI 正在生成学习计划……</p>';
      api('/api/learning/plan', {
        method: 'POST',
        body: JSON.stringify({ domain: domain, level: currentLevel }),
      })
        .then(function (data) {
          if (data.ok) {
            progress = data.progress;
            renderPlan();
          } else {
            planArea.innerHTML =
              '<p class="error">' + escapeHtml(data.error || '生成失败') + '</p>' +
              '<button type="button" class="generate-btn" data-generate-btn>重试</button>';
          }
        })
        .catch(function () {
          planArea.innerHTML =
            '<p class="error">网络错误，请稍后重试。</p>' +
            '<button type="button" class="generate-btn" data-generate-btn>重试</button>';
        });
    }

    function renderPlan() {
      if (!progress || !progress.plan) { showGenerateButton(); return; }

      var plan = progress.plan;
      var levelLabel = levelLabels[plan.level] || '';
      var nodeCount = plan.nodes.length;
      var passedCount = 0;
      Object.keys(progress.nodes).forEach(function (id) {
        if (progress.nodes[id].status === 'passed') passedCount++;
      });

      planBadge.textContent = levelLabel + ' · ' + passedCount + '/' + nodeCount + ' 通过';
      kpBadge.textContent = levelLabel + ' · ' + nodeCount + ' 个知识点';

      var nodesHtml = plan.nodes.map(function (node) {
        var np = progress.nodes[node.id] || { status: 'pending', attempts: 0 };
        var stLabel = statusLabels[np.status] || '待学习';
        var prereq = '';
        if (node.prerequisites && node.prerequisites.length > 0) {
          var titles = node.prerequisites.map(function (id) {
            var pre = plan.nodes.find(function (n) { return n.id === id; });
            return pre ? pre.title : id;
          });
          prereq = '<span class="prereq">前置：' + escapeHtml(titles.join('、')) + '</span>';
        }
        return (
          '<div class="plan-node ' + np.status + '">' +
            '<div class="node-status">' + stLabel + '</div>' +
            '<div class="node-body">' +
              '<h3>' + escapeHtml(node.title) + '</h3>' +
              '<p>' + escapeHtml(node.description) + '</p>' +
              prereq +
              '<div class="node-actions">' +
                '<a href="/domains/' + encodeURIComponent(domain) + '/kp/' + encodeURIComponent(node.id) + '" class="node-link">进入知识点 →</a>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }).join('');

      planArea.innerHTML = '<div class="plan-nodes">' + nodesHtml + '</div>';

      var cardsHtml = plan.nodes.map(function (node) {
        var np = progress.nodes[node.id] || { status: 'pending', attempts: 0 };
        var stLabel = statusLabels[np.status] || '待学习';
        return (
          '<a href="/domains/' + encodeURIComponent(domain) + '/kp/' + encodeURIComponent(node.id) + '" class="kp-card ' + np.status + '">' +
            '<div class="kp-card-status">' + stLabel + '</div>' +
            '<h3>' + escapeHtml(node.title) + '</h3>' +
            '<p>' + escapeHtml(node.description) + '</p>' +
          '</a>'
        );
      }).join('');

      kpGrid.innerHTML = cardsHtml;
    }

    function showGenerateButton() {
      planArea.innerHTML = '<button type="button" class="generate-btn" data-generate-btn>生成学习计划</button>';
      planBadge.textContent = '待生成';
      kpBadge.textContent = '待生成';
      kpGrid.innerHTML = '<p class="plan-hint">请先在上方「学习路线」生成学习计划。</p>';
    }

    levelTabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        levelTabs.forEach(function (t) { t.classList.remove('active'); });
        tab.classList.add('active');
        currentLevel = tab.getAttribute('data-level');
        if (progress && progress.plan && progress.level === currentLevel) {
          renderPlan();
        } else {
          showGenerateButton();
        }
      });
    });

    planArea.addEventListener('click', function (e) {
      if (e.target && e.target.matches('[data-generate-btn]')) generatePlan();
    });

    loadProgress();
  })();
</script>
