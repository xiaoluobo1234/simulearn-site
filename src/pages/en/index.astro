---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';

const fields = [
  { id: 'structural', code: 'ST', title: 'Structural', status: 'Practiced', progress: 72, color: '#3dd6c6', desc: 'FEA, dynamics, nonlinear analysis and verification.' },
  { id: 'thermal', code: 'TH', title: 'Thermal', status: 'Learning', progress: 28, color: '#ff9f68', desc: 'Heat transfer, thermal resistance and package thermal stress.' },
  { id: 'fluids', code: 'FL', title: 'Fluids', status: 'Planned', progress: 12, color: '#67a8ff', desc: 'CFD for air cooling, liquid cooling and microchannels.' },
  { id: 'multiphysics', code: 'MP', title: 'Multiphysics', status: 'Learning', progress: 22, color: '#b69cff', desc: 'Thermal-structural and fluid-thermal-structural coupling.' },
  { id: 'chip', code: 'CH', title: 'Chip Simulation', status: 'Planned', progress: 8, color: '#ffcf66', desc: 'Package reliability first, device and process TCAD later.' },
];
---

<BaseLayout lang="en" flush>
  <section class="en-hero">
    <div class="container-wide">
      <span>SIMULATION KNOWLEDGE SYSTEM · 2026—2036</span>
      <h1>From structural FEA<br />to <em>chip multiphysics</em></h1>
      <p>{siteConfig.description.en}</p>
      <div>
        <a class="btn btn-primary" href="#fields">Explore the fields ↓</a>
        <a class="btn btn-ghost" href="/cases">View case library →</a>
      </div>
    </div>
  </section>

  <section class="field-section content-section" id="fields">
    <div class="container-wide">
      <div class="section-heading">
        <div><span class="eyebrow">Domain navigation</span><h2>One structure across five fields</h2></div>
        <p>The Chinese edition contains the complete working knowledge base. English covers the core positioning, selected cases and tools.</p>
      </div>
      <div class="field-grid">
        {fields.map((field) => (
          <article id={field.id} style={`--accent:${field.color}`}>
            <div><span>{field.code}</span><small>{field.status}</small></div>
            <h3>{field.title}</h3>
            <p>{field.desc}</p>
            <i><b style={`width:${field.progress}%`}></b></i>
            <span class="progress">{field.progress}% roadmap progress</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="principles content-section">
    <div class="container-wide">
      <div><span>01</span><h3>Reasoning over clicks</h3><p>Record model choices, assumptions and decision logic—not only software steps.</p></div>
      <div><span>02</span><h3>Evidence over plots</h3><p>Use conservation, convergence, sensitivity and benchmark checks to support conclusions.</p></div>
      <div><span>03</span><h3>Postmortems over showcases</h3><p>Keep failed branches and missing evidence visible so the case remains honest and reusable.</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .en-hero { min-height: 610px; display: grid; align-items: center; color: #acc0c1; background: radial-gradient(circle at 78% 30%, rgba(18,175,163,.18), transparent 25%), var(--color-primary-deep); }
  .en-hero .container-wide > span { color: #6ed2c8; font: 500 .68rem/1 var(--font-mono); letter-spacing: .12em; }
  .en-hero h1 { color: white; margin: 1.4rem 0; font-size: clamp(3rem, 7vw, 5.4rem); line-height: 1.05; }
  .en-hero h1 em { color: #76ddd3; font-style: normal; }
  .en-hero p { max-width: 680px; }
  .en-hero .container-wide > div { display: flex; flex-wrap: wrap; gap: .7rem; }
  .field-section { background: white; }
  .field-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .7rem; }
  .field-grid article { min-height: 280px; padding: 1.2rem; display: flex; flex-direction: column; border: 1px solid var(--color-border); border-top: 3px solid var(--accent); scroll-margin-top: 100px; }
  .field-grid article > div { display: flex; justify-content: space-between; }
  .field-grid article > div span { color: var(--accent); font: 600 .65rem/1 var(--font-mono); }
  .field-grid article small { color: #819298; font-size: .65rem; }
  .field-grid h3 { margin: 2rem 0 .8rem; }
  .field-grid p { color: var(--color-text-secondary); font-size: .76rem; }
  .field-grid i { display: block; height: 3px; margin-top: auto; background: var(--color-code-bg); }
  .field-grid b { display: block; height: 100%; background: var(--accent); }
  .progress { margin-top: .6rem; color: #89999e; font: 500 .6rem/1 var(--font-mono); }
  .principles { background: #dfe8e6; }
  .principles .container-wide { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #c7d6d3; border: 1px solid #c7d6d3; }
  .principles .container-wide > div { padding: 2rem; background: white; }
  .principles span { color: var(--color-accent); font: 600 .65rem/1 var(--font-mono); }
  .principles h3 { margin: 1.5rem 0 .8rem; }
  .principles p { margin: 0; color: var(--color-text-secondary); font-size: .8rem; }
  @media (max-width: 950px) { .field-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .en-hero { min-height: 540px; }
    .field-grid, .principles .container-wide { grid-template-columns: 1fr; }
  }
</style>
