---
// English Homepage V2
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import ArticleCard from '../../components/ArticleCard.astro';

const features = [
  { title: 'Diagnostics', desc: 'Not manuals — diagnostic cards. Each follows "Symptom → Decision Tree → Root Cause → Fix → Verify" structure.', icon: '🔍', href: '/en/diagnostic', color: '#2563eb' },
  { title: 'Failure Museum', desc: 'Crashed simulations and postmortems. The focus: "why I made this mistake" and how to avoid it.', icon: '💥', href: '/en/failures', color: '#dc2626' },
  { title: 'Tools', desc: 'Parameter predictor calculator: input aspect ratio and load type, get analysis type and mesh strategy.', icon: '⚙️', href: '/en/tools', color: '#16a34a' },
  { title: 'Error Lookup', desc: 'Got a solver error? Search by software/error code/keyword. Goal: first place you think of when errors hit.', icon: '🚨', href: '/en/errors', color: '#f59e0b' },
];

const recentPosts = [
  { title: 'Getting Started with FEA: From Theory to ANSYS Practice', date: '2026-06-27', summary: 'Introduction to FEA with a hands-on static analysis of a simply supported beam in ANSYS Workbench.', category: 'software-tutorial', categoryLabel: 'Software Tutorial', href: '/en/blog/first-post' },
  { title: 'Book Notes: "A First Course in the Finite Element Method" (Ch. 1)', date: '2026-06-25', summary: 'Chapter 1 notes on spring elements, stiffness matrices, and the direct stiffness method.', category: 'book-notes', categoryLabel: 'Book Notes', href: '/en/blog/first-post' },
  { title: 'How Mesh Density Affects Simulation Accuracy', date: '2026-06-20', summary: 'Comparing mesh densities and element types on a bracket stress analysis.', category: 'challenges', categoryLabel: 'Challenges', href: '/en/blog/first-post' },
];
---

<BaseLayout lang="en">
  <section class="hero container">
    <h1 class="hero-title">{siteConfig.title}</h1>
    <p class="hero-subtitle">{siteConfig.subtitle.en}</p>
    <p class="hero-desc">{siteConfig.description.en}</p>
  </section>

  <section class="features container-wide">
    <div class="feature-grid">
      {features.map((f) => (
        <a href={f.href} class="feature-card card" style={`--accent: ${f.color}`}>
          <span class="feature-icon">{f.icon}</span>
          <div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
          <span class="feature-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="value container">
    <h2 class="section-title">Not Just Tutorials</h2>
    <div class="value-grid">
      <div class="value-item">
        <h3>Diagnostic Thinking &gt; Click-by-Click</h3>
        <p>90% of simulation content online is button-pushing tutorials. Here we build "diagnostic reports" — structured troubleshooting with decision logic maps.</p>
      </div>
      <div class="value-item">
        <h3>Physical Intuition &gt; Numerical Output</h3>
        <p>Binding abstract physics to concrete numerical signatures. "Residual oscillation isn't always mesh — it could be BC-initial field mismatch" — judgment that generic AI can't replicate.</p>
      </div>
      <div class="value-item">
        <h3>Failure Postmortems &gt; Success Stories</h3>
        <p>Public failure cases with annotated mistake analysis. When you can clearly articulate your errors, you build not just authority but trust.</p>
      </div>
    </div>
  </section>

  <section class="recent container-wide">
    <h2 class="section-title">Recent Articles</h2>
    <div class="card-grid">
      {recentPosts.map((post) => (
        <ArticleCard {...post} lang="en" />
      ))}
    </div>
    <div class="section-more">
      <a href="/en/blog" class="btn">View all articles →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { text-align: center; padding: var(--space-3xl) 0 var(--space-xl); max-width: 680px; }
  .hero-title { font-size: 3rem; letter-spacing: -0.03em; margin-bottom: var(--space-sm); margin-top: 0; }
  .hero-subtitle { font-family: var(--font-heading); font-size: 1.2rem; color: var(--color-accent); font-weight: 500; margin-bottom: var(--space-lg); }
  .hero-desc { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 0; }
  .features { margin: var(--space-xl) auto var(--space-3xl); }
  .feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  .feature-card { display: flex; align-items: flex-start; gap: var(--space-md); text-decoration: none; color: inherit; padding: var(--space-lg); border-left: 3px solid var(--accent, var(--color-border)); transition: all var(--transition); }
  .feature-card:hover { text-decoration: none; transform: translateX(4px); box-shadow: var(--shadow-md); }
  .feature-icon { font-size: 1.5rem; flex-shrink: 0; }
  .feature-title { font-size: 1.1rem; margin: 0 0 var(--space-xs); }
  .feature-desc { font-size: 0.875rem; color: var(--color-text-secondary); margin: 0; line-height: 1.6; }
  .feature-arrow { margin-left: auto; color: var(--accent); font-size: 1.2rem; flex-shrink: 0; opacity: 0; transition: opacity var(--transition); }
  .feature-card:hover .feature-arrow { opacity: 1; }
  .value { margin: var(--space-3xl) auto; }
  .section-title { font-size: 1.5rem; margin-bottom: var(--space-lg); margin-top: 0; border: none; padding: 0; }
  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .value-item h3 { font-size: 1.05rem; margin: 0 0 var(--space-sm); }
  .value-item p { font-size: 0.9rem; color: var(--color-text-secondary); margin: 0; line-height: 1.7; }
  .recent { margin: var(--space-3xl) auto; }
  .section-more { text-align: center; margin-top: var(--space-xl); }
  @media (max-width: 768px) {
    .hero-title { font-size: 2.2rem; }
    .feature-grid { grid-template-columns: 1fr; }
    .value-grid { grid-template-columns: 1fr; gap: var(--space-lg); }
  }
</style>
