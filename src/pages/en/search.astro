  { type: 'error' as const, code: 'FLUENT-007', title: 'Global Courant Number Too Large', message: 'Global Courant number is greater than 250', software: 'Fluent', physics: 'CFD Solver' },
  { type: 'error' as const, code: 'FLUENT-008', title: 'UDF Compilation/Load Error', message: 'The UDF library you are trying to load — compilation error', software: 'Fluent', physics: 'CFD UDF' },
  { type: 'error' as const, code: 'LSDYNA-001', title: 'Mass Increase Termination', message: 'Termination due to mass increase', software: 'LS-DYNA', physics: 'Explicit Dynamics' },
