  { type: 'error' as const, code: 'LSDYNA-003', title: 'Out-of-Range Velocities / NaN', message: 'Out-of-range velocities — NaN detected', software: 'LS-DYNA', physics: 'Explicit Dynamics' },
  { type: 'error' as const, code: 'LSDYNA-004', title: 'Contact Penetration (Part Overlap)', message: 'Contact penetration — visible overlap between parts', software: 'LS-DYNA', physics: 'Explicit Dynamics' },
