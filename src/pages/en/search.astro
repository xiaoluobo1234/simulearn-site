const searchIndex = [...kpEntries, ...errorEntries];
const searchIndexJson = JSON.stringify(searchIndex);
---

<BaseLayout title="Search" description="Search knowledge points, error codes and simulation content" lang="en" flush>
  <section class="page-hero search-hero">
    <div class="container-wide">
      <span class="eyebrow">SEARCH</span>
      <h1>Site Search</h1>
      <p>{kpEntries.length} knowledge points + {errorEntries.length} error codes across 6 domains</p>

      <div class="search-box">
        <input type="text" id="searchInput" class="search-input-main" placeholder="Search knowledge points, error codes, keywords…" autofocus autocomplete="off" />
      </div>

      <div class="search-filters" id="searchFilters">
        <button class="filter-chip active" data-filter="all">All</button>
        {domains.map((domain) => (
          <button class="filter-chip" data-filter={domain}>{learningDomainLabels[domain]}</button>
        ))}
        <button class="filter-chip" data-filter="error">Errors</button>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container-wide">
      <div class="search-stats" id="searchStats"></div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">
          <span>🔍</span>
          <h3>Type a keyword to start searching</h3>
          <p>Try "contact convergence", "rigid body", "pivot", "mesh distortion"...</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/json" id="searchIndexData" set:html={searchIndexJson}></script>

<script>
  interface SearchItem {
    type: 'kp' | 'error'; slug?: string; code?: string; title: string;
    description?: string; message?: string; domain?: string; group?: string;
    level?: string; software?: string; physics?: string;
  }
  const INDEX: SearchItem[] = JSON.parse(document.getElementById('searchIndexData')?.textContent || '[]');
  const domainLabels: Record<string, string> = { structural: 'Structural', thermal: 'Thermal', fluids: 'Fluids', multiphysics: 'Multiphysics', chip: 'Chip', tools: 'Tools' };
  const levelLabels: Record<string, string> = { low: 'Basic', mid: 'Intermediate', high: 'Advanced' };

  function escapeHtml(v: unknown) { return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c] || c); }
  function highlight(text: string, query: string): string {
    if (!query) return escapeHtml(text);
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return escapeHtml(text).replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
  }
  function score(item: SearchItem, query: string): number {
    const q = query.toLowerCase(); let s = 0;
    const title = item.title.toLowerCase();
    if (title === q) s += 100;
    else if (title.includes(q)) s += 50;
    if (item.description?.toLowerCase().includes(q)) s += 20;
    if (item.message?.toLowerCase().includes(q)) s += 15;
    if (item.code?.toLowerCase().includes(q)) s += 30;
    if (item.group?.toLowerCase().includes(q)) s += 10;
    if (item.physics?.toLowerCase().includes(q)) s += 10;
    return s;
  }

  let activeFilter = 'all';
  function doSearch() {
    const input = document.getElementById('searchInput') as HTMLInputElement;
    const query = input?.value?.trim() || '';
    const results = document.getElementById('searchResults');
    const stats = document.getElementById('searchStats');
    if (!results || !stats) return;
    if (!query) {
      results.innerHTML = `<div class="search-empty"><span>🔍</span><h3>Type a keyword to start searching</h3><p>Try "contact convergence", "rigid body", "pivot", "mesh distortion"...</p></div>`;
      stats.innerHTML = ''; return;
    }
    let matched = INDEX.map(item => ({ item, s: score(item, query) })).filter(({ s }) => s > 0);
    if (activeFilter !== 'all') {
      matched = matched.filter(({ item }) => activeFilter === 'error' ? item.type === 'error' : item.domain === activeFilter);
    }
    matched.sort((a, b) => b.s - a.s || a.item.title.localeCompare(b.item.title));
    const top = matched.slice(0, 60);
    stats.innerHTML = `Found <strong>${top.length}</strong> results (KP ${top.filter(({ item }) => item.type === 'kp').length} · Errors ${top.filter(({ item }) => item.type === 'error').length})`;
    if (!top.length) { results.innerHTML = `<div class="search-empty"><span>😕</span><h3>No results found</h3><p>Try shorter keywords or switch domain filter.</p></div>`; return; }
    results.innerHTML = top.map(({ item }) => {
      if (item.type === 'kp') {
        return `<a href="/domains/${item.domain}/kp/${item.slug}/" class="search-result-item"><span class="result-type result-type-kp">KP</span><span class="result-domain">${escapeHtml(domainLabels[item.domain || ''] || item.domain)} · ${escapeHtml(levelLabels[item.level || ''] || item.level)}</span><h3>${highlight(item.title, query)}</h3><p>${highlight(item.description || '', query)}</p></a>`;
      } else {
        return `<a href="/errors/#${item.code}" class="search-result-item"><span class="result-type result-type-error">ERR</span><span class="result-domain">${escapeHtml(item.software || '')} · ${escapeHtml(item.physics || '')}</span><h3><b>${escapeHtml(item.code || '')}</b> ${highlight(item.title, query)}</h3><p>${highlight(item.message || '', query)}</p></a>`;
      }
    }).join('');
  }

  document.getElementById('searchInput')?.addEventListener('input', doSearch);
  document.querySelectorAll('#searchFilters .filter-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('#searchFilters .filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      activeFilter = (chip as HTMLElement).dataset.filter || 'all';
      doSearch();
    });
  });
  if (window.location.hash) {
    const hashQuery = decodeURIComponent(window.location.hash.slice(1));
    const input = document.getElementById('searchInput') as HTMLInputElement;
    if (input) { input.value = hashQuery; doSearch(); }
  }
</script>

<style>
  .search-hero { padding: 3.5rem 0 2.5rem; text-align: center; }
  .search-hero h1 { margin: 0.5rem 0 0.8rem; }
  .search-hero p { margin: 0 auto 1.8rem; max-width: 560px; font-size: 0.9rem; }
  .search-box { max-width: 620px; margin: 0 auto 1.2rem; }
  .search-input-main { width: 100%; height: 54px; padding: 0 1.2rem; font-size: 1.05rem; font-family: var(--font-heading); color: var(--color-text); background: var(--color-surface); border: 2px solid var(--color-border); border-radius: var(--radius-lg); outline: none; transition: border-color var(--transition), box-shadow var(--transition); }
  .search-input-main:focus { border-color: var(--color-accent); box-shadow: 0 0 0 4px rgba(12, 143, 135, 0.1); }
  .search-input-main::placeholder { color: #9aaeb3; }
  .search-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; }
  .filter-chip { padding: 0.38rem 0.75rem; font-size: 0.72rem; font-family: var(--font-heading); color: var(--color-text-secondary); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 100px; cursor: pointer; transition: all var(--transition); }
  .filter-chip:hover, .filter-chip.active { color: white; background: var(--color-accent); border-color: var(--color-accent); }
  .search-stats { margin-bottom: 1rem; color: var(--color-text-secondary); font-size: 0.78rem; }
  .search-results { display: grid; gap: 0.6rem; }
  .search-empty { grid-column: 1 / -1; display: grid; place-items: center; align-content: center; min-height: 300px; text-align: center; color: #9ba8ab; }
  .search-empty > span { font-size: 2.5rem; }
  .search-empty h3 { margin: 1rem 0 0.5rem; color: #6b7e84; }
  .search-empty p { margin: 0; font-size: 0.8rem; max-width: 400px; }
  .search-result-item { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1rem; align-items: baseline; padding: 1rem 1.2rem; color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); transition: all var(--transition); }
  .search-result-item:hover { border-color: var(--color-accent); transform: translateX(3px); color: var(--color-text); }
  .result-type { grid-row: 1 / 3; padding: 0.2em 0.5em; border-radius: 100px; font-size: 0.6rem; font-weight: 650; font-family: var(--font-heading); align-self: start; margin-top: 0.15rem; }
  .result-type-kp { background: #dff4f1; color: #086961; }
  .result-type-error { background: #fff0d9; color: #8a5b28; }
  .result-domain { font-size: 0.65rem; color: var(--color-text-secondary); }
  .search-result-item h3 { grid-column: 2; margin: 0; font-size: 0.95rem; line-height: 1.4; }
  .search-result-item h3 b { font-family: var(--font-mono); font-size: 0.75rem; margin-right: 0.4rem; color: var(--color-accent); }
  .search-result-item p { grid-column: 2; margin: 0; font-size: 0.78rem; color: var(--color-text-secondary); line-height: 1.5; }
  .search-result-item mark { background: #fef3c7; color: #92400e; padding: 0.05em 0.15em; border-radius: 2px; }
  @media (max-width: 600px) { .search-hero { padding: 2.5rem 0 2rem; } .search-result-item { padding: 0.85rem 0.9rem; } }
</style>
