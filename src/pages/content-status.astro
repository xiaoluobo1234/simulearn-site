---
import BaseLayout from '../layouts/BaseLayout.astro';
import {contentProvenance,contentCorrectionHref} from '../data/content-provenance';
import {getBuildContentReviewPack} from '../lib/content-review-build';
import '../styles/linear-static-project.css';
const reviewPack=getBuildContentReviewPack();
---
<BaseLayout title="内容版本与审核索引" description="分别查看内容版本、修订范围、待复核状态与构建参考证据。" flush>
  <section class="project-hero project-hero--compact"><div class="container-wide"><div class="project-breadcrumb"><a href="/">首页</a><span>/</span>内容版本</div><h1>让每条修订，<br/><em>都有可追溯的依据。</em></h1><p>以下内容版本已有对应源码和修订说明；人工审核信息尚未登记。构建参考校验、内容审核和个人学习状态分别记录。</p></div></section>
  <div class="container-wide project-content">
    <section class="project-callout review-download" aria-labelledby="review-pack-title"><div><h2 id="review-pack-title">下载一份可以逐项核对的人工审核包</h2><p>{reviewPack.items.length} 项内容，包含固定内容版本、相关正文与算法、输入和参考附件的 SHA-256，以及尚未填写的审核人、日期、结论和检查清单。下载或测试通过都不会批准发布。</p><p>本次构建源码提交：<code>{reviewPack.sourceCommit}</code>；工作树：{reviewPack.workingTree}。逐文件字节不匹配时不提供相应的永久链接。</p></div><a class="project-button" href="/downloads/content-review.md" download>下载人工审核清单 Markdown ↓</a><a class="project-button project-button--quiet" href="/downloads/content-review.json" download>下载版本与文件指纹 JSON ↓</a></section>
    <div class="project-case-grid">{contentProvenance.map(item=>{const snapshot=reviewPack.items.find(value=>value.id===item.id);const source=snapshot?.files.find(file=>file.path===item.sourcePath);return <article class="project-case-card"><span>{item.version} · 待本人复核</span><h2 style="font-size:1.1rem;margin:.4rem 0"><a href={item.href}>{item.title}</a></h2><p>{item.changes[0].summary}</p>{snapshot&&<details class="review-item-source"><summary>核对版本与相关文件</summary><p>{snapshot.files.length} 个相关文件；文件集合 SHA-256：<code>{snapshot.fingerprint}</code>。</p><p>主要正文或算法：<code>{item.sourcePath}</code></p>{source?.commitUrl?<a href={source.commitUrl} target="_blank" rel="noreferrer">查看相符的源码提交 ↗</a>:<p>当前文件字节尚无相符的提交链接；逐文件指纹见下载包，审核仍待登记。</p>}</details>}<a href={contentCorrectionHref(item)} target="_blank" rel="noreferrer">针对这一版本报告问题 ↗</a></article>;})}</div><aside class="project-callout"><div><h2>报告内容问题</h2><p>纠错入口会预填公开页面地址和内容版本，之后由你在 GitHub 表单中确认、补充并提交。它不会附带私人练习、浏览记录、代码或工程附件。审核与修订通过仓库评审流程留下记录。</p><p>构建参考证据状态：{reviewPack.automatedEvidence.status}。此证据只涉及三套案例的三项目标量、输入指纹与参考自检，未逐项验证全部输出；人工内容审核独立登记。</p></div><a href="/generated/learning-evidence.json">查看本次构建参考校验清单 ↗</a></aside></div>
</BaseLayout>
<style>.review-download p,.review-item-source{overflow-wrap:anywhere}.review-download code,.review-item-source code{font-size:.7rem}.review-item-source{font-size:.75rem;color:var(--color-text-secondary)}.review-item-source summary{cursor:pointer;color:var(--color-accent)}.review-item-source p{font-size:.75rem;margin-top:.6rem}</style>
