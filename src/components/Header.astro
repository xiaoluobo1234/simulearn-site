---
import { siteConfig } from '../config';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const navLinks = siteConfig.nav[lang];
const domainLinks = siteConfig.nav.zh.filter((link) => link.href.startsWith('/domains/'));
const primaryLinks = [
  { label: '学习路径', href: '/learning' },
  { label: '工程案例', href: '/cases' },
  { label: '工具脚本', href: '/tools' },
];
const resourceLinks = lang === 'zh'
  ? [...siteConfig.resourceNav.zh, { label: '在线仿真', href: '/cae/' }]
  : siteConfig.resourceNav.en;
const otherLangLabel = lang === 'zh' ? 'EN' : '中文';
const otherLangHref = lang === 'zh' ? '/en' : '/';
const homeHref = lang === 'zh' ? '/' : '/en';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && pathname.startsWith(href);
---

<header class="site-header" data-header>
  <div class="header-inner container-wide">
    <a href={homeHref} class="site-logo" aria-label="SimuLearn home">
      <span class="logo-mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span>
        <strong>{siteConfig.title}</strong>
        <small>SIMULATION FIELD NOTES</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-label={lang === 'zh' ? '打开导航' : 'Open menu'} aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav id="site-navigation" class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'} data-menu>
      <div class="domain-links">
        {lang === 'zh' ? <>
          <details class="resource-menu domain-menu" data-domain-menu>
            <summary class:list={['nav-link', { active: domainLinks.some((link) => isActive(link.href)) }]}>
              学习领域
              <svg class="nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="resource-panel domain-panel">
              {domainLinks.map((link) => <a href={link.href} class:list={{ active: isActive(link.href) }} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
            </div>
          </details>
          {primaryLinks.map((link) => <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined} data-primary-nav>{link.label}</a>)}
        </> : navLinks.map((link) => (
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
            {link.label}
          </a>
        ))}
      </div>

      <details class="resource-menu" data-resource-menu>
        <summary class="nav-link">
          {lang === 'zh' ? '资源' : 'Resources'}
          <svg class="nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="resource-panel">
          {resourceLinks.map((link) => (
            <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>
          ))}
        </div>
      </details>

      <a href={otherLangHref} class="lang-switch" aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}>
        {otherLangLabel}
      </a>

      <a href={lang === 'zh' ? '/search' : '/en/search'} class="search-link" aria-label={lang === 'zh' ? '搜索' : 'Search'} title={lang === 'zh' ? '全站搜索' : 'Search'}>
        <svg class="header-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      </a>

      <a href="/login" class="login-link" data-login-link aria-label={lang === 'zh' ? '登录' : 'Log in'}>
        <svg class="header-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20v-1a7 7 0 0 1 14 0v1" /></svg>
      </a>

      <div class="user-menu" data-user-menu hidden>
        <button class="user-avatar" type="button" data-user-avatar title={lang === 'zh' ? '用户菜单' : 'User menu'} aria-label={lang === 'zh' ? '用户菜单' : 'User menu'}></button>
        <div class="user-dropdown">
          <span data-user-name></span>
          <button type="button" data-logout>退出登录</button>
        </div>
      </div>

      <button class="theme-toggle" type="button" aria-label={lang === 'zh' ? '切换暗色或亮色模式' : 'Toggle dark or light mode'} data-theme-toggle title={lang === 'zh' ? '切换暗色/亮色模式' : 'Toggle dark/light mode'}>
        <span class="theme-icon-light"><svg class="header-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" /></svg></span>
        <span class="theme-icon-dark"><svg class="header-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.7 8.7 0 0 1 9.5 3.5a8.7 8.7 0 1 0 11 11Z" /></svg></span>
      </button>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll('[data-header]').forEach((header) => {
    const toggle = header.querySelector('[data-menu-toggle]');
    const menu = header.querySelector('[data-menu]');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
      toggle.addEventListener('click', () => {
      const open = header.getAttribute('data-open') !== 'true';
      header.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
    });
  });

  // User state
  (async () => {
    try {
      const resp = await fetch('/api/auth/me', { credentials: 'same-origin' });
      const data = await resp.json();
      if (data.ok && data.user) {
        const u = data.user;
        const loginLink = document.querySelector('[data-login-link]');
        const userMenu = document.querySelector('[data-user-menu]');
        const avatar = document.querySelector('[data-user-avatar]');
        const nameEl = document.querySelector('[data-user-name]');
        if (loginLink) loginLink.setAttribute('hidden', '');
        if (userMenu) userMenu.removeAttribute('hidden');
        if (avatar) avatar.textContent = (u.name || '?')[0].toUpperCase();
        if (nameEl) nameEl.textContent = u.name || u.email || '';
      }
    } catch { /* not logged in — show login link */ }
  })();

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    const headers = new Headers();
    const token = window.__simulearn?.getCsrfToken?.();
    if (token) headers.set('X-CSRF-Token', token);
    await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin', headers });
    window.location.reload();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
	    border-bottom: 1px solid var(--color-border);
	    background: var(--color-header-bg);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .site-logo:hover { color: var(--color-primary); }
  .site-logo strong { display: block; font: 750 1.08rem/1 var(--font-heading); letter-spacing: -0.02em; }
  .site-logo small { display: block; margin-top: 0.32rem; font: 500 0.55rem/1 var(--font-mono); letter-spacing: 0.13em; color: var(--color-text-secondary); }

  .logo-mark {
    width: 29px;
    height: 29px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    transform: rotate(45deg);
  }

  .logo-mark i { display: block; border: 1px solid var(--color-accent); }
  .logo-mark i:nth-child(1), .logo-mark i:nth-child(4) { background: var(--color-accent); }

  .site-nav, .domain-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.55rem 0.58rem;
    border-radius: var(--radius);
    color: var(--color-primary);
    font: 550 0.82rem/1 var(--font-heading);
    white-space: nowrap;
  }

  .nav-link:hover, .nav-link.active, .resource-menu[open] > summary {
    color: var(--color-primary);
    background: var(--color-code-bg);
  }

  .nav-link.active { color: var(--color-accent); }
  .resource-menu { position: relative; }
  .resource-menu summary { list-style: none; cursor: pointer; }
  .resource-menu summary::-webkit-details-marker { display: none; }
  .nav-chevron { flex: none; transition: transform var(--transition); }
  .resource-menu[open] > summary .nav-chevron { transform: rotate(180deg); }
  .header-icon { display: block; flex: none; }
  .login-link[hidden], .user-menu[hidden] { display: none; }
  .domain-panel { left: 0; right: auto; }
  .site-header a:focus-visible, .site-header button:focus-visible, .site-header summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

	  .resource-panel {
	    position: absolute;
	    right: 0;
	    top: calc(100% + 0.65rem);
	    width: 185px;
	    padding: 0.55rem;
	    display: grid;
	    gap: 0.1rem;
	    background: var(--color-dropdown-bg);
	    border: 1px solid var(--color-border);
	    border-radius: 10px;
	    box-shadow: var(--shadow-lg);
	  }

	  .resource-panel::before {
	    content: '';
	    position: absolute;
	    height: 0.75rem;
	    left: 0;
	    right: 0;
	    top: -0.75rem;
	  }

	  .resource-panel a {
	    padding: 0.58rem 0.7rem;
	    border-radius: 5px;
	    color: var(--color-text-secondary);
	    font: 500 0.82rem/1.3 var(--font-heading);
	  }

	  .resource-panel a:hover, .resource-panel a.active { color: var(--color-accent); background: var(--color-code-bg); }

	  .lang-switch {
	    margin-left: 0.45rem;
	    min-width: 42px;
	    padding: 0.38rem 0.62rem;
	    text-align: center;
	    border: 1px solid var(--color-border);
	    border-radius: 100px;
	    color: var(--color-primary);
	    font: 600 0.7rem/1 var(--font-mono);
	  }

	  .lang-switch:hover { border-color: var(--color-accent); color: var(--color-accent); }
	  .menu-toggle { display: none; }

	  .search-link {
	    display: grid;
	    place-items: center;
	    width: 36px;
	    height: 36px;
	    border: 1px solid var(--color-border);
	    border-radius: 100px;
	    color: var(--color-text-secondary);
	    font-size: 0.8rem;
	    transition: all var(--transition);
	    margin-left: 0.3rem;
	  }
	  .search-link:hover { border-color: var(--color-accent); color: var(--color-accent); }

	  .login-link {
	    display: grid; place-items: center;
	    width: 36px; height: 36px;
	    border: 1px solid var(--color-border);
	    border-radius: 100px;
	    color: var(--color-text-secondary);
	    font-size: 0.8rem;
	    transition: all var(--transition);
	    margin-left: 0.3rem;
	  }
	  .login-link:hover { border-color: var(--color-accent); color: var(--color-accent); }

	  .user-menu { position: relative; margin-left: 0.3rem; }
	  .user-avatar {
	    width: 36px; height: 36px;
	    display: grid; place-items: center;
	    border: 1px solid var(--color-border);
	    border-radius: 100px;
	    background: var(--color-code-bg);
	    cursor: pointer;
	    font-size: 0.9rem;
	    font-weight: 700;
	    color: var(--color-accent);
	  }
	  .user-avatar:hover { border-color: var(--color-accent); }
	  .user-dropdown {
	    display: none; position: absolute; right: 0; top: calc(100% + 0.5rem);
	    min-width: 160px; padding: 0.8rem;
	    background: var(--color-surface); border: 1px solid var(--color-border);
	    border-radius: var(--radius); box-shadow: var(--shadow-md);
	    text-align: center;
	  }
	  .user-menu:hover .user-dropdown, .user-menu:focus-within .user-dropdown { display: grid; gap: 0.5rem; }
	  .user-dropdown span { font-size: 0.8rem; color: var(--color-text); font-weight: 600; }
	  .user-dropdown button {
	    padding: 0.35rem 0.7rem; font-size: 0.7rem;
	    border: 1px solid var(--color-border); border-radius: var(--radius);
	    background: var(--color-surface); color: var(--color-text-secondary);
	    cursor: pointer;
	  }
	  .user-dropdown button:hover { color: var(--color-danger-text); border-color: var(--color-danger-border); }

	  .theme-toggle {
	    margin-left: 0.3rem;
	    width: 36px;
	    height: 36px;
	    display: grid;
	    place-items: center;
	    border: 1px solid var(--color-border);
	    border-radius: 100px;
	    background: transparent;
	    cursor: pointer;
	    font-size: 0.85rem;
	    line-height: 1;
	    color: var(--color-text-secondary);
	    transition: all var(--transition);
	  }
	  .theme-toggle:hover { border-color: var(--color-accent); color: var(--color-accent); }

	  .theme-icon-light { display: grid; }
	  .theme-icon-dark { display: none; }
	  :global(html[data-theme="dark"]) .theme-icon-light { display: none; }
	  :global(html[data-theme="dark"]) .theme-icon-dark { display: grid; }

	  @media (max-width: 1040px) {
	    .header-inner { min-height: 64px; }
	    .menu-toggle {
	      width: 42px;
	      height: 42px;
	      display: grid;
	      place-content: center;
	      gap: 5px;
	      border: 1px solid var(--color-border);
	      border-radius: var(--radius);
	      background: var(--color-surface);
	    }
	    .menu-toggle span { display: block; width: 19px; height: 1px; background: var(--color-primary); }

	    .site-nav {
	      display: none;
	      position: absolute;
	      left: 0;
	      right: 0;
	      top: 100%;
	      max-height: calc(100vh - 64px);
	      overflow-y: auto;
	      padding: 1rem var(--space-lg) 1.35rem;
	      background: var(--color-dropdown-bg);
	      border-bottom: 1px solid var(--color-border);
	      box-shadow: var(--shadow-md);
	      align-items: stretch;
	    }

	    .site-header[data-open='true'] .site-nav { display: grid; gap: 0.65rem; }
	    .domain-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.25rem; }
	    .domain-menu { grid-column: 1 / -1; }
	    .nav-link { padding: 0.75rem; }
	    .resource-menu { border-top: 1px solid var(--color-border-light); padding-top: 0.6rem; }
	    .domain-menu { border-top: 0; padding-top: 0; }
	    .resource-panel { position: static; width: auto; border: 0; box-shadow: none; padding: 0.3rem 0 0; grid-template-columns: repeat(2, 1fr); }
	    .resource-panel::before { display: none; }
	    .lang-switch { justify-self: start; margin: 0; padding: 0.5rem 0.8rem; }
	  }

	  @media (max-width: 420px) {
	    .site-logo small { display: none; }
	    .domain-links, .resource-panel { grid-template-columns: 1fr; }
	  }
</style>
