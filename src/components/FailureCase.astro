---
// FailureCase.astro - 失败案例卡片
interface Props {
  title: string;
  date: string;
  software: string;
  physics: string;
  whatHappened: string;     // 发生了什么
  whyWrong: string;         // 我当时为什么犯了这个错
  whatLearned: string;      // 复盘学到了什么
  lang: 'zh' | 'en';
}

const { title, date, software, physics, whatHappened, whyWrong, whatLearned, lang } = Astro.props;

const formatDate = (d: string, l: string) => {
  const dt = new Date(d);
  return l === 'zh'
    ? `${dt.getFullYear()}年${dt.getMonth()+1}月${dt.getDate()}日`
    : dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

const L = lang === 'zh'
  ? { happened: '发生了什么', whyWrong: '我当时为什么犯了这个错', learned: '复盘：学到了什么' }
  : { happened: 'What Happened', whyWrong: 'Why I Made This Mistake', learned: 'Postmortem: What I Learned' };
---

<article class="failure-card card">
  <header class="fail-header">
    <span class="fail-icon">💥</span>
    <div>
      <h3 class="fail-title">{title}</h3>
      <div class="meta">
        <time>{formatDate(date, lang)}</time>
        <span class="meta-separator"></span>
        <span class="tag tag-software">{software}</span>
        <span class="tag tag-physics">{physics}</span>
      </div>
    </div>
  </header>

  <div class="fail-body">
    <section class="fail-section what-happened">
      <h4>{L.happened}</h4>
      <p>{whatHappened}</p>
    </section>
    <section class="fail-section why-wrong">
      <h4>{L.whyWrong}</h4>
      <p>{whyWrong}</p>
    </section>
    <section class="fail-section what-learned">
      <h4>{L.learned}</h4>
      <p>{whatLearned}</p>
    </section>
  </div>
</article>

<style>
  .failure-card { overflow: hidden; padding: 0; }

  .fail-header {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-xl);
    border-bottom: 1px solid var(--color-border-light);
  }
  .fail-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
  .fail-title { margin: 0 0 var(--space-xs); font-size: 1.15rem; }

  .fail-body { padding: var(--space-xl); }
  .fail-section { margin-bottom: var(--space-lg); }
  .fail-section:last-child { margin-bottom: 0; }
  .fail-section h4 {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-sm);
  }
  .fail-section p { margin: 0; font-size: 0.95rem; line-height: 1.7; }

	  .what-happened h4 { color: var(--color-danger-text); }
	  .why-wrong h4 { color: var(--color-warning-text); }
	  .what-learned h4 { color: var(--color-success-text); }

	  .tag-software { background: var(--color-info-bg); color: var(--color-info-text); }
	  .tag-physics { background: var(--color-warning-bg); color: var(--color-warning-text); }
</style>
