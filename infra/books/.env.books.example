# Cloudflare R2 S3 API (server-side only; never put these in Worker variables)
R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=simulearn-books
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE

# Dedicated Redis logical DB and prefix; do not use Dify/Celery queues.
REDIS_URL=redis://redis:6379/15
BOOK_POLL_SECONDS=10
BOOK_MAX_MB=50
BOOK_MAX_PAGES=200

# 8 GiB server: use an independent MinerU API.
MINERU_MODE=api
MINERU_API_URL=https://REPLACE_MINERU_SERVICE
MINERU_API_TOKEN=
# Only after upgrading to >=16 GiB: MINERU_MODE=cli
MINERU_CLI=mineru

# OpenAI-compatible summarizer adapter. Leave both blank to skip guide/summaries.
# This adapter is the replaceable "Grimoire" layer; it never receives permission
# to rewrite the MinerU body.
SUMMARY_API_URL=https://api.deepseek.com/v1
SUMMARY_API_KEY=REPLACE
SUMMARY_MODEL=deepseek-chat

DIFY_API_URL=https://ai.simulearn.cn
DIFY_DATASET_API_KEY=REPLACE
DIFY_DATASETS_JSON={"structural":"REPLACE","thermal":"REPLACE","fluids":"REPLACE","multiphysics":"REPLACE","chip":"REPLACE"}
