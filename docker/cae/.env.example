# ===========================================
# SimuLearn CAE - Environment Configuration
# Copy to .env and fill in your values
# ===========================================

# ── Database ──
# PostgreSQL connection details
POSTGRES_DB=simulearn_cae
POSTGRES_USER=simulearn
POSTGRES_PASSWORD=  # REQUIRED: Set a strong random password
DB_PASSWORD=         # REQUIRED (prod): Must match POSTGRES_PASSWORD

# ── MinIO (S3-compatible object storage) ──
MINIO_USER=          # REQUIRED: MinIO admin username
MINIO_PASS=          # REQUIRED: MinIO admin password (strong)
MINIO_BUCKET=simulearn-cae

# ── Redis / Celery ──
# Uses default Redis port; no additional config needed typically

# ── JWT Authentication ──
# MUST match the JWT_SECRET set in Cloudflare Workers (wrangler secret put JWT_SECRET)
JWT_SECRET=          # REQUIRED

# ── OpenAI (optional, for AI agent features) ──
OPENAI_API_KEY=

# ── Other ──
SIMULATION_TIMEOUT=300
