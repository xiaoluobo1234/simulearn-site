{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simulearn-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ai", "/ai/*", "/api/ai/*", "/api/books", "/api/books/*", "/books/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "simulearn-books"
    }
  ],
  "vars": {
    "SIMULEARN_AI_MODE": "live",
    "DIFY_API_URL": "https://ai.simulearn.cn",
    "DIFY_REVIEW_FILE_INPUT": "documents",
    "MAX_UPLOAD_MB": "15",
    "BOOK_IMPORT_MAX_MB": "50"
  }
}
